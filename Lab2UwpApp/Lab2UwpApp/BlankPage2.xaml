<Page
    x:Class="Lab2UwpApp.BlankPage2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lab2UwpApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Background="#FFB9D9DC">
        <TextBlock HorizontalAlignment="Left" Margin="391,30,0,0" Text="Online Student Registration Form" VerticalAlignment="Top" Height="42" Width="513" FontFamily="Calibri" FontSize="36" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="64,126,0,0" Text="User Name:" VerticalAlignment="Top" Height="42" Width="216" FontFamily="Calibri" FontSize="36" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="64,202,0,0" Text="Password:" VerticalAlignment="Top" Height="42" Width="216" FontFamily="Calibri" FontSize="36" FontWeight="Bold" RenderTransformOrigin="0.463,2.906"/>
        <TextBlock HorizontalAlignment="Left" Margin="64,285,0,0" Text="Gender:" VerticalAlignment="Top" Height="42" Width="216" FontFamily="Calibri" FontSize="36" FontWeight="Bold" RenderTransformOrigin="0.463,2.906"/>
        <TextBlock HorizontalAlignment="Left" Margin="64,360,0,0" Text="Payment Option:" VerticalAlignment="Top" Height="42" Width="288" FontFamily="Calibri" FontSize="36" FontWeight="Bold" RenderTransformOrigin="0.463,2.906"/>
        <TextBox x:Name="txtUserName" HorizontalAlignment="Left" Margin="260,126,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="285" FontFamily="Arial Rounded MT Bold" FontSize="24"/>
        <PasswordBox x:Name="txtPassword" HorizontalAlignment="Left" Margin="260,202,0,0" VerticalAlignment="Top" FontFamily="Arial Rounded MT Bold" FontSize="24" Width="285"/>
        <RadioButton x:Name="rbMale" Content="Male" Margin="260,291,0,0" VerticalAlignment="Top" FontFamily="Arial Rounded MT Bold" FontSize="24" GroupName="gender"/>
        <RadioButton x:Name="rbFemale" Content="Female" Margin="465,291,0,0" VerticalAlignment="Top" FontFamily="Arial Rounded MT Bold" FontSize="24" GroupName="gender"/>
        <RadioButton x:Name="rbCard" Content="Debit/Credit" Margin="362,364,0,0" VerticalAlignment="Top" FontFamily="Arial Rounded MT Bold" FontSize="24" GroupName="payment" Width="199"/>
        <RadioButton x:Name="rbBank" Content="Netbanking" Margin="584,364,0,0" VerticalAlignment="Top" FontFamily="Arial Rounded MT Bold" FontSize="24" GroupName="payment" RenderTransformOrigin="0.492,1.311"/>
        <RadioButton x:Name="rbPaypal" Content="Paypal" Margin="824,364,0,0" VerticalAlignment="Top" FontFamily="Arial Rounded MT Bold" FontSize="24" GroupName="payment"/>
        <CheckBox x:Name="cbTerm" Content="I agree to all your Terms and Cconditions." Margin="221,475,0,0" VerticalAlignment="Top" Width="806" FontSize="24" FontWeight="Bold"/>
        <Button x:Name="btnSignUp" Content="Sign Up" Margin="124,578,0,0" VerticalAlignment="Top" Width="193" FontSize="24" FontWeight="Bold" Click="btnSignUp_Click"/>
        <Button x:Name="btnClose" Content="Close Form" Margin="867,578,0,0" VerticalAlignment="Top" Width="193" FontSize="24" FontWeight="Bold" Click="btnClose_Click"/>
        <Button x:Name="btnReset" Content="Reset Form" Margin="487,578,0,0" VerticalAlignment="Top" Width="193" FontSize="24" FontWeight="Bold" Click="btnReset_Click"/>
        <ListView x:Name="userList" Margin="678,111,31,411" RenderTransformOrigin="0.5,0.5" Background="#FF78D5A4" AllowDrop="True">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="12,0,10,0"  >
                        <TextBlock Text="ID"  Width="50" Foreground="#FF1E1D1D" FocusVisualPrimaryBrush="{x:Null}" />
                        <TextBlock Text="Username" Width="100" Foreground="#FF1E1D1D" />
                        <TextBlock Text="Password" Width="80" Foreground="#FF1E1D1D" />
                        <TextBlock Text="Gender" Width="100" Foreground="#FF1E1D1D" />
                        <TextBlock Text="Payment" Width="100" Foreground="#FF1E1D1D" />
                    </StackPanel>
                </DataTemplate>
            </ListView.HeaderTemplate>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:User">
                    <StackPanel Orientation="Horizontal" >
                        <TextBlock x:Name="ItemId"
                            Text="{x:Bind Path=Id}"
                            Width="50" />
                        <TextBlock x:Name="ItemName"
                            Text="{x:Bind Path=Username}"
                            Width="100" />
                        <TextBlock Text="{x:Bind Path=Password}"
                            Width="80" />
                        <TextBlock Text="{x:Bind Path=Gender}"
                            Width="100" />
                        <TextBlock Text="{x:Bind Path=Payment}"
                            Width="100" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button x:Name="btnResetPwd" Content="Reset" Margin="562,200,0,0" VerticalAlignment="Top" Width="98" FontSize="24" FontWeight="Bold" Click="btnResetPwd_Click"/>

    </Grid>
</Page>
