@{
    ViewData["Title"] = "Index";
    var role = ViewBag.UserRole;
    var userName = ViewBag.UserName;
}

@model OrderViewModel

<div class="text-center mt-4">
    Hello, @userName
    <a asp-action="Logout" asp-controller="User" class="btn btn-info text-dark btn-lg ml-2">Logout</a>
</div>
<div class="container mt-4">
    <div class="row">
        <!-- Product Cards -->
        <div class="col-md-6">
            <h4>Products</h4>
            <div class="row">
                @foreach (var product in Model.Products)
                {
                    <div class="col-md-6 mb-3">
                        <div class="card">
                            <img src="@product.ImageUrl" class="card-img-top" alt="@product.ProductName">
                            <div class="card-body">
                                <h5 class="card-title">@product.ProductName</h5>
                                <p class="card-text">$@product.Price</p>
                                <div class="input-group mb-3">
                                    <button class="btn btn-outline-secondary" type="button" onclick="decreaseQty(@product.Id)">-</button>
                                    <input type="text" class="form-control text-center" id="qty-@product.Id" value="1" readonly>
                                    <button class="btn btn-outline-secondary" type="button" onclick="increaseQty(@product.Id)">+</button>
                                </div>
                                <button class="btn btn-primary w-100" onclick="addToCart(@product.Id)">Add to Cart</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Cart Section -->
        <div class="col-md-6">
            <h4>Cart</h4>
            <div id="cart-container">
            @await Html.PartialAsync("_Cart", Model.CartItems)
            </div>
        </div>

        <div class="mt-3">
            <h5>Summary</h5>
            <p>Subtotal: $<span id="subtotal">@Model.SubTotal</span></p>
            <p>Tax: $<span id="tax">@Model.Tax</span></p>
            <h5>Total: $<span id="total">@Model.Total</span></h5>
            <button class="btn btn-success w-100" onclick="placeOrder()">Place Order</button>
        </div>
    </div>
</div>  


<script>
    function increaseQty(productId) {
        let qtyInput = document.getElementById(`qty-${productId}`);
        qtyInput.value = parseInt(qtyInput.value) + 1;
    }

    function decreaseQty(productId) {
        let qtyInput = document.getElementById(`qty-${productId}`);
        if (parseInt(qtyInput.value) > 1) {
            qtyInput.value = parseInt(qtyInput.value) - 1;
        }
    }

    function addToCart(productId) {
        let qty = parseInt(document.getElementById(`qty-${productId}`).value);

        
        fetch('/cart/AddToCart', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                // 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: JSON.stringify({ productId, qty})
        })
            .then(response => response.json())
            .then(data => {
                console.log(data);
                // Update Cart
               let cartContainer = document.getElementById('cart-container');
                cartContainer.innerHTML = generateCartHtml(data.cartItems);
            
                // Update Summary
            document.getElementById('subtotal').innerText = data.subTotal.toFixed(2);
            document.getElementById('tax').innerText = data.tax.toFixed(2);
            document.getElementById('total').innerText = data.total.toFixed(2);
            })
            .catch(error => console.error('Error:', error));
    }

     function generateCartHtml(cartItems) {
        let html = `
            <table class="table">
                <thead>
                    <tr>
                        <th>Product ID</th>
                        <th>Product Name</th>
                        <th>Qty</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
        `;
        cartItems.forEach(item => {
            html += `
                <tr>
                    <td>${item.productId}</td>
                    <td>${item.productName}</td>
                    <td>${item.qty}</td>
                    <td>$${item.subTotal.toFixed(2)}</td>
                </tr>
            `;
        });
        html += `</tbody></table>`;
        return html;
    }

        function placeOrder() {
    const subtotal = document.getElementById('subtotal').innerText;

    fetch('/order/PlaceOrder', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({ subtotal })
    })
    .then(response => {
        if (response.ok) {
            // Redirect to the PaymentSuccess page after successful order placement
            window.location.href = '/Order';
        } else {
            // Handle error response (optional)
            console.error('Error placing order:', response.statusText);
        }
    })
    .catch(error => console.error('Error:', error));
}

</script>