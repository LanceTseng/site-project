
@{
    ViewData["Title"] = "PaymentSuccess";
}

<div class="success-container">
    <div class="success-icon">
        <i class="fa fa-check-circle"></i>
    </div>
    <h1>Payment Successful!</h1>
    <p>Your payment has been processed successfully. Thank you for your purchase!</p>
    <a asp-action="Index" asp-controller="Home" class="btn btn-outline-success text-dark btn-lg ml-2">Home</a>
</div>

<style>
    .success-container {
        text-align: center;
        margin-top: 100px;
        padding: 20px;
        background-color: #f9f9f9;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        max-width: 500px;
        margin-left: auto;
        margin-right: auto;
    }

    .success-icon {
        font-size: 60px;
        color: #28a745;
        margin-bottom: 20px;
    }

    h1 {
        color: #333;
        font-size: 24px;
        margin-bottom: 10px;
    }

    p {
        color: #555;
        margin-bottom: 20px;
    }

    .btn {
        text-decoration: none;
        color: white;
        padding: 10px 20px;
        border-radius: 5px;
    }

    .btn-primary {
        background-color: #007bff;
        border: none;
    }

    .btn-primary:hover {
        background-color: #0056b3;
    }
</style>
