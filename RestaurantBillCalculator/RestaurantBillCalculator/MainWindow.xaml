<Window x:Class="RestaurantBillCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RestaurantBillCalculator"
        mc:Ignorable="d"
        Title="MainWindow" Height="618" Width="914">
    <Grid Background="Cornsilk">
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="Menu" VerticalAlignment="Top" FontSize="20px" Margin="184,23,0,0" TextDecorations="Underline" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="660,23,0,0" TextWrapping="Wrap" Text="Bill" VerticalAlignment="Top" FontSize="20px" RenderTransformOrigin="1.957,0.494" FontWeight="Bold" TextDecorations="Underline"/>
        <StackPanel Background="#FFE1D8B7" Margin="10,140,504,30">
            <DataGrid Height="100" d:ItemsSource="{d:SampleData ItemCount=5}"/>
        </StackPanel>
        <StackPanel Background="#FFE1D8B7" Margin="457,197,26,30">
            <DataGrid Height="100" d:ItemsSource="{d:SampleData ItemCount=5}"/>
        </StackPanel>
        <ComboBox HorizontalAlignment="Left" Margin="10,55,0,0" VerticalAlignment="Top" Width="400"/>
        <Button x:Name="btnRemove" Content="Remove" HorizontalAlignment="Left" Margin="733,66,0,0" VerticalAlignment="Top" FontSize="20" Width="125"/>
        <Button x:Name="btnClear" Content="Clear Bill" HorizontalAlignment="Left" Margin="733,125,0,0" VerticalAlignment="Top" FontSize="20" Width="125"/>
        <StackPanel Background="#FFE1D8B7" Margin="457,59,209,424">
            <Grid Height="92" Width="247">
                <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="Subtotal:" VerticalAlignment="Top" FontSize="20px" FontWeight="Bold" FontStyle="Italic"/>
                <TextBox x:Name="txtSubtotal" TextWrapping="Wrap" Text="TextBox"  FontSize="20" IsEnabled="False" Margin="99,0,69,65"/>
                <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="Tax:" VerticalAlignment="Top" FontSize="20px" FontWeight="Bold" RenderTransformOrigin="1.268,0.242" Margin="48,32,0,0" FontStyle="Italic"/>
                <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="Total:" VerticalAlignment="Top" FontSize="20px" FontWeight="Bold" Margin="33,64,0,0" FontStyle="Italic"/>
                <TextBox x:Name="txtTax" TextWrapping="Wrap" Text="TextBox" FontSize="20" IsEnabled="False" Margin="99,32,69,32"/>
                <TextBox x:Name="txtTotal" TextWrapping="Wrap" Text="TextBox"  FontSize="20" IsEnabled="False" RenderTransformOrigin="2.415,0.617" Margin="99,64,69,1"/>
            </Grid>
        </StackPanel>
        <Button x:Name="btnRemove_Copy" Content="Remove" HorizontalAlignment="Left" Margin="10,88,0,0" VerticalAlignment="Top" FontSize="20" Width="125"/>


    </Grid>
</Window>
