<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Offboarding Employee</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Navbar -->
    <%- include('../partials/navbar') %>

    <div class="container mt-5">
      <h2 class="text-center">Employee Offboarding</h2>
      <div class="row">
        <div class="col-md-12">
          <div class="mb-3">
            <input
              type="text"
              id="searchInput"
              class="form-control"
              placeholder="Search Employee..."
            />
          </div>
          <div class="table-container">
            <table class="table table-striped table-hover">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>First Name</th>
                  <th>Last Name</th>
                  <th>Status</th>
                  <th>Department</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="employeeTableBody">
                <!-- Data will be loaded here -->
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="offboardModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Offboard Employee</h5>
            <button
              type="button"
              class="close"
              data-dismiss="modal"
              aria-label="Close"
            >
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="modal-body">
            <p>
              Are you sure you want to offboard <strong id="employeeName"></strong>?
            </p>
            <input type="hidden" id="employeeId" />
    
            <!-- Offboarding Date Selection -->
            <div class="form-group">
              <label for="offboardDate">Select Offboarding Date</label>
              <input
                type="date"
                class="form-control"
                id="offboardDate"
                required
              />
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-danger" id="confirmOffboard">
              Offboard
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <%- include('../partials/footer-simple') %>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Custom JS -->
    <script src="/js/offboard.js" type="module"></script>
  </body>
</html>
<style>
  .parent {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    padding: 20px;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    background: white;
  }
  .table-container {
    max-height: 600px;
    overflow-y: auto;
    border-radius: 10px;
  }
  thead th {
    position: sticky;
    top: 0;
    background: #000000 !important;
    color: white !important;
    z-index: 10;
  }
  tbody tr:hover {
    background-color: #f1f1f1;
  }
</style>
