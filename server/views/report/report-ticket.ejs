<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ticket Request</title>
    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <!-- Font Awesome CSS -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="css/report-ticket.css" />
  </head>

  <body>
    <!-- Navbar -->
    <%- include('../partials/navbar') %>

    <div class="container-fluid">
      <div class="row mt-3">
        <!-- Search Tickets Section -->
        <div class="col-md-4">
          <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white">
              <i class="fas fa-search mr-2"></i>Search Tickets
            </div>
            <div class="card-body">
              <form id="search-form">
                <div class="form-group">
                  <label for="searchTicket">Topic</label>
                  <input
                    type="text"
                    id="searchTicket"
                    class="form-control form-control-sm"
                    placeholder="Enter Task Name"
                  />
                </div>
                <div class="form-group">
                  <label for="searchDepartment">Department</label>
                  <select
                    id="searchDepartment"
                    class="form-control form-control-sm"
                  >
                    <option value="" selected>Select a Department</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="searchTicketStatus">Status</label>
                  <select
                    id="searchTicketStatus"
                    class="form-control form-control-sm"
                  >
                    <option value="" selected>Select a Status</option>
                  </select>
                </div>
                <button type="submit" class="btn btn-dark btn-block">
                  <i class="fas fa-search mr-1"></i> Search
                </button>
              </form>
            </div>
          </div>
        </div>

        <!-- Ticket Forum Section -->
        <div class="col-md-8">
          <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white">
              <i class="fas fa-ticket-alt mr-2"></i>Ticket Forum
            </div>
            <div class="card-body">
              <button
                type="button"
                class="btn btn-dark mb-3"
                data-toggle="modal"
                data-target="#ticketModal"
              >
                <i class="fas fa-plus mr-1"></i> Create Ticket
              </button>
              <h5>Submitted Tickets</h5>
              <div class="table-responsive">
                <table class="table table-striped table-hover">
                  <thead class="thead-dark">
                    <tr>
                      <th>Ticket#</th>
                      <th>Ticket Topic</th>
                      <th>Ticket Status</th>
                      <th>Department</th>
                      <th>Created By</th>
                      <th>Created Date</th>
                    </tr>
                  </thead>
                  <tbody id="ticketTableBody">
                    <!-- Data will be loaded dynamically -->
                    <tr>
                      <td colspan="6" class="text-center">
                        <div class="spinner-border" role="status">
                          <span class="sr-only">Loading...</span>
                        </div>
                        <p>Loading tickets...</p>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Ticket Details Section -->
      <div class="row mt-3">
        <div class="col-md-12">
          <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white">
              <i class="fas fa-info-circle mr-2"></i>Ticket Details
            </div>
            <div class="card-body">
              <h5 id="ticketTitle" class="font-weight-bold">[Ticket Topic]</h5>
              <p id="ticketDescription" class="text-muted">
                [Ticket Description]
              </p>
              <p id="ticketId" class="text-muted" hidden></p>

              <h6 class="mt-4">Actions</h6>
              <div class="d-flex flex-wrap">
                <button
                  type="button"
                  class="btn btn-info btn-sm mr-2 mb-2 btn-update-status"
                  data-status="1"
                  id="btnReOpen"
                >
                  <i class="fas fa-undo mr-1"></i> ReOpen
                </button>
                <button
                  type="button"
                  class="btn btn-warning btn-sm mr-2 mb-2 btn-update-status"
                  data-status="2"
                  id="btnProcessing"
                >
                  <i class="fas fa-spinner fa-spin mr-1"></i> Processing
                </button>
                <button
                  type="button"
                  class="btn btn-success btn-sm mr-2 mb-2 btn-update-status"
                  data-status="3"
                  id="btnCompleted"
                >
                  <i class="fas fa-check-circle mr-1"></i> Completed
                </button>
                <button
                  type="button"
                  class="btn btn-danger btn-sm mr-2 mb-2 btn-update-status"
                  data-status="4"
                  id="btnCancel"
                >
                  <i class="fas fa-times-circle mr-1"></i> Cancelled
                </button>
                <button
                  type="button"
                  class="btn btn-danger btn-sm mr-2 mb-2 btn-update-status"
                  data-status="5"
                  id="btnReject"
                >
                  <i class="fas fa-ban mr-1"></i> Reject
                </button>
              </div>

              <h6 class="mt-4">Comments</h6>
              <div id="commentsSection" class="card p-3 mt-2">
                <!-- Existing Comments Will Be Loaded Here -->
              </div>

              <!-- Comment Input -->
              <div class="card p-3 mt-3" id="response-area">
                <h6>Reply</h6>
                <textarea
                  id="commentInput"
                  class="form-control"
                  rows="3"
                  placeholder="Write a comment..."
                ></textarea>
                <button id="postComment" class="btn btn-dark mt-2">
                  Post Reply
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Create Ticket Modal -->
    <div
      class="modal fade"
      id="ticketModal"
      tabindex="-1"
      aria-labelledby="ticketModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header bg-light">
            <h5 class="modal-title" id="ticketModalLabel">
              Create a New Ticket
            </h5>
            <button
              type="button"
              class="close"
              data-dismiss="modal"
              aria-label="Close"
            >
              <span>×</span>
            </button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label for="addTicketTitle" class="form-label">Title</label>
              <input
                type="text"
                class="form-control"
                id="addTicketTitle"
                placeholder="Enter ticket title"
              />
            </div>
            <div class="mb-3">
              <label for="addTicketDepartment" class="form-label"
                >Issue Department</label
              >
              <select id="addTicketDepartment" class="form-control" required>
                <option value="" selected>Select a Department</option>
              </select>
            </div>
            <div class="mb-3">
              <label for="addTicketDescription" class="form-label"
                >Description</label
              >
              <textarea
                class="form-control"
                id="addTicketDescription"
                rows="3"
                placeholder="Describe your issue"
              ></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-secondary"
              data-dismiss="modal"
            >
              Cancel
            </button>
            <button id="submitTicket" class="btn btn-primary">
              Submit Ticket
            </button>
          </div>
        </div>
      </div>
    </div>
    <!-- Footer -->
    <%- include('../partials/footer-simple') %>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="js/report-ticket.js" type="module"></script>
  </body>
</html>
<style>
  body {
    font-family: Arial, sans-serif;
    background-color: #f8f9fa;
  }

  .container-fluid {
    padding: 15px;
  }

  /* Card styling */
  .card {
    border: none;
    margin-bottom: 1.5rem;
    border-radius: 0.5rem;
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
  }

  .card-header {
    font-weight: bold;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.125);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .card-body {
    padding: 1.25rem;
  }

  /* Table styling */
  .table thead th {
    background-color: #343a40;
    color: #fff;
    border-bottom: 2px solid #495057;
    font-size: 0.9rem;
  }

  .table tbody td {
    font-size: 0.85rem;
    vertical-align: middle;
  }

  .table-striped tbody tr:nth-of-type(odd) {
    background-color: rgba(0, 0, 0, 0.05);
  }

  .table-hover tbody tr:hover {
    background-color: rgba(0, 0, 0, 0.075);
  }

  /* Form styling */
  .form-control-sm {
    font-size: 0.8rem;
  }

  /* Comments section */
  #commentsSection {
    max-height: 250px;
    overflow-y: auto;
    padding: 0.75rem;
    border: 1px solid #ced4da;
    border-radius: 0.25rem;
    background-color: #fff;
  }

  #commentsSection .comment {
    margin-bottom: 0.75rem;
    padding: 0.5rem;
    border-radius: 0.25rem;
    background-color: #f8f9fa;
    border: 1px solid #dee2e6;
  }

  #commentsSection .comment strong {
    font-size: 0.9rem;
    font-weight: bold;
  }

  #commentsSection .comment p {
    font-size: 0.8rem;
    margin-bottom: 0.25rem;
  }

  /* Modal styling */
  .modal-header {
    background-color: #f8f9fa;
    border-bottom: 1px solid #dee2e6;
  }

  /* Button styling */
  .btn-primary {
    background-color: #007bff;
    border-color: #007bff;
  }

  .btn-primary:hover {
    background-color: #0069d9;
    border-color: #0062cc;
  }

  .btn-success {
    background-color: #28a745;
    border-color: #28a745;
  }

  .btn-success:hover {
    background-color: #218838;
    border-color: #1e7e34;
  }

  /* Loading indicator */
  .loading-indicator {
    text-align: center;
    padding: 20px;
    color: #6c757d;
  }

  /* Utility classes */
  .mt-3 {
    margin-top: 1.5rem;
  }
</style>
