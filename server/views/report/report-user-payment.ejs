<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Employee Payment</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
  </head>

  <body>
    <!-- Navbar -->
    <%- include('../partials/navbar') %>
    <div class="parent">
      <!-- search section -->
      <div class="container">
        <h2 class="text-center">Salary Payment</h2>
        <form id="search-form">
          <div class="form-row align-items-end">
            <div class="col-md-3">
              <label for="searchName" class="font-weight-bold"
                >Employee Name</label
              >
              <input
                type="text"
                id="searchName"
                class="form-control"
                placeholder="Enter User Name"
              />
            </div>
            <div class="col-md-3">
              <label for="searchDepartment" class="font-weight-bold"
                >Department</label
              >
              <select id="searchDepartment" class="form-control">
                <option value="" disabled selected>Select a Department</option>
              </select>
            </div>
            <div class="col-md-3">
              <label for="searchEmpStatus" class="font-weight-bold"
                >Status</label
              >
              <select id="searchEmpStatus" class="form-control">
                <option value="" disabled selected>Select a Status</option>
              </select>
            </div>
            <div class="col-md-3">
              <button
                type="submit"
                class="btn btn-primary btn-block"
                id="btnSearch"
              >
                Search
              </button>
            </div>
          </div>
        </form>
      </div>

      <!-- table -->
      <div class="table-container">
        <table class="table table-striped table-hover">
          <thead>
            <tr>
              <th>User ID</th>
              <th>First Name</th>
              <th>Last Name</th>
              <th>Status</th>
              <th>Payment Type</th>
              <th>Annual Salary</th>
              <th>Weekly Work Hours</th>
              <th>Termination Pay</th>
              <th>Created At</th>
              <th>Updated At</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="paymentTableBody">
            <!-- Data will be loaded dynamically -->
          </tbody>
        </table>
      </div>
    </div>
    <!-- Footer -->
    <%- include('../partials/footer-simple') %>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/report-user-payment.js" type="module"></script>
  </body>
</html>
<style>
  .parent-search-div {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 1fr;
    grid-column-gap: 0px;
    grid-row-gap: 0px;
  }
  .parent {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    padding: 20px;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    background: white;
  }
  .table-container {
    max-height: 600px;
    overflow-y: auto;
    border-radius: 10px;
  }
  thead th {
    position: sticky;
    top: 0;
    background: #000000 !important;
    color: white !important;
    z-index: 10;
  }
  tbody tr:hover {
    background-color: #f1f1f1;
  }
</style>
