<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Offboarding Employee</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <style>
    .parent {
      display: grid;
      grid-template-columns: 200px auto auto;
      grid-template-rows: 1fr;
      grid-column-gap: 20px;
      grid-row-gap: 0px;
      margin-right: 1%;
      margin-left: 1%;
      margin-top: 1%;
    }
    .table-responsive {
      max-height: 400px;
      overflow-y: auto;
    }

    thead th {
      position: sticky;
      top: 0;
      background: white;
      z-index: 10;
    }
  </style>
  <body>
    <!-- Navbar -->
    <%- include('../partials/navbar') %>

    <div class="parent">
      <div class="mb-4">
        <h3>Task Filter</h3>
        <div class="form-group">
          <label for="taskFilter">Filter by Task Name</label>
          <input
            type="text"
            id="taskFilter"
            class="form-control"
            placeholder="Enter Task Name"
          />
        </div>
        <button id="processQuery" class="btn btn-primary">Process Query</button>
      </div>

      <div id="userTaskHeader" class="mb-4">
        <h4>User Task Header</h4>
        <div class="row">
          <div class="col-12">
            <div
              class="table-responsive"
              style="max-height:700px; overflow-y: auto"
            >
              <table class="table table-striped">
                <thead
                  class="thead-dark"
                  style="
                    position: sticky;
                    top: 0;
                    background: white;
                    z-index: 10;
                  "
                >
                  <tr>
                    <th>User Name</th>
                    <th>Task Name</th>
                    <th>Task Description</th>
                    <th>Task Group</th>
                    <th>Status</th>
                    <th>Process Rate</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Last Updated</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody id="userTaskHeaderList"></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- User Task Detail Section -->
      <div id="userTaskDetail" class="mb-4">
        <h4>User Task Detail</h4>
        <div class="row">
          <div class="col-12">
            <div class="table-responsive" style="max-height: 700px; overflow-y: auto;">
              <table class="table table-striped">
                <thead class="thead-dark" style="position: sticky; top: 0; background: white; z-index: 10;">
                  <tr>
                    <th>Subtask Name</th>
                    <th>Subtask Description</th>
                    <th>Subtask Status</th>
                    <th>Document</th>
                    <th>Document Upload</th>
                    <th>Device Type</th>
                    <th>Device</th>
                    <th>Training Module</th>
                    <th>Interview</th>
                    <th>Survey</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Last Updated</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody id="userTaskDetailList"></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
      
    </div>

    <!-- Footer -->
    <%- include('../partials/footer-simple') %>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Custom JS -->
    <script src="/js/report-user-task.js" type="module"></script>
  </body>
</html>
