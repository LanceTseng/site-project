<style>
  body {
    background-color: #f8f9fa;
  }

  .menu-card {
    border-radius: 12px;
    box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
  }

  .menu-card:hover {
    transform: translateY(-5px);
    box-shadow: 0px 6px 12px rgba(0, 0, 0, 0.15);
  }

  .menu-card .card-body {
    padding: 30px;
  }

  .menu-card i {
    display: block;
    margin-bottom: 10px;
  }
</style>
