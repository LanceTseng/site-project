<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Unauthorized Access</title>

    <!-- Bootstrap 5 & Font Awesome -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <style>
      /* Background Gradient */
      body {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        text-align: center;
      }

      /* Glassmorphism Effect */
      .error-container {
        max-width: 450px;
        padding: 40px;
        border-radius: 15px;
        background: #dbcaaa5d;
        box-shadow: 0px 10px 30px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        text-align: center;
        border: 1px solid rgba(255, 255, 255, 0.3);
      }

      /* Warning Icon */
      .warning-icon {
        font-size: 60px;
        color: #dc3545;
        animation: shake 0.6s infinite alternate;
      }

      /* Title */
      h1 {
        color: #dc3545;
        font-weight: bold;
        margin-top: 15px;
      }

      /* Description */
      p {
        font-size: 18px;
        color: #333;
      }

      /* Button Styling */
      .btn-custom {
        background: #424c57;
        color: #fff;
        padding: 12px 24px;
        font-size: 18px;
        border-radius: 50px;
        text-decoration: none;
        transition: all 0.3s ease-in-out;
        display: inline-block;
        margin-top: 20px;
      }

      .btn-custom:hover {
        background: #8092a5;
        transform: scale(1.05);
      }

      /* Shake Animation */
      @keyframes shake {
        0% {
          transform: translateX(-5px);
        }
        100% {
          transform: translateX(5px);
        }
      }
    </style>
  </head>

  <body>
    <div class="error-container">
      <i class="fas fa-exclamation-triangle warning-icon"></i>
      <h1 class="display-6">Unauthorized Access</h1>
      <p class="lead">You do not have permission to view this page.</p>
      <a href="/login" class="btn btn-custom">
        <i class="fas fa-home me-2"></i> Return to Homepage
      </a>
    </div>
  </body>
</html>
