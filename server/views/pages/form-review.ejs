<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Survey Review</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <style>
      .survey-container {
        max-width: 800px;
        margin: auto;
        background: #fff;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
      }
      h2 {
        font-weight: bold;
        color: #333;
      }
    </style>
  </head>

  <body>
    <!-- Navbar -->
    <%- include('../partials/navbar') %>

    <div class="container my-5">
      <div class="survey-container">
        <h2 id="form-title" class="text-center mb-4">Survey Review</h2>
        <div id="survey-content"></div>
        <button
          type="button"
          id="backBtn"
          class="btn btn-primary mt-3 d-block mx-auto"
        >
          Back
        </button>
      </div>
    </div>

    <!-- Footer -->
    <%- include('../partials/footer-simple') %>

    <!-- JS Dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/form-review.js" type="module"></script>
  </body>
</html>
