<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Equipment Management</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      .parent {
        display: grid;
        grid-template-columns: 0.5fr 1.5fr 2fr;
        gap: 20px;
        padding: 20px;
      }
      .table-container {
        max-height: 600px;
        overflow-y: auto;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        border-radius: 10px;
      }
      thead th {
        position: sticky;
        top: 0;
        background: #000000 !important;
        color: white !important;
        z-index: 10;
      }
    </style>
  </head>

  <body>
    <!-- Navbar -->
    <%- include('../partials/navbar') %>

    <div class="mt-4">
      <h2>Equipment Management</h2>
      <div class="parent">
        <!-- Search Section -->
        <div>
          <input
            type="text"
            id="search-field"
            class="form-control mb-2"
            placeholder="Search by name"
          />

          <button id="search-btn" class="btn btn-primary w-100">Search</button>
          <p></p>
          <button id="new-equipment-btn" class="btn btn-success w-100">
            Add New Equipment
          </button>
        </div>

        <!-- Equipment Table -->
        <div>
          <h3>Equipment List</h3>
          <div class="table-container shadow-sm p-3 bg-white rounded">
            <table class="table table-hover mt-4">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Eqpt Name</th>
                  <th>Code</th>
                  <th>Type</th>
                  <th>Occupied By</th>
                  <th>Occupied</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="equipment-table-body"></tbody>
            </table>
          </div>
        </div>

        <!-- Occupied Record -->
        <div>
          <h3>Occupied Record</h3>
          <div class="table-container shadow-sm p-3 bg-white rounded">
            <table class="table table-hover mt-4">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Occupied Name</th>
                  <th>Occupied Date</th>
                  <th>Occupied Task</th>
                  <th>Released Date</th>
                  <th>Released Task</th>
                </tr>
              </thead>
              <tbody id="eqpt-occupied-table-body"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Edit/New Modal -->
    <div
      class="modal fade"
      id="edit-modal"
      tabindex="-1"
      aria-labelledby="editModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="editModalLabel">Edit Equipment</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body">
            <form id="edit-form">
              <input type="hidden" id="edit-id" />

              <div class="form-group mb-3">
                <label for="edit-name" class="form-label">Name</label>
                <input
                  type="text"
                  id="edit-name"
                  class="form-control"
                  required
                />
              </div>

              <div class="form-group mb-3">
                <label for="edit-code" class="form-label">Equipment Code</label>
                <input
                  type="text"
                  id="edit-code"
                  class="form-control"
                  required
                />
              </div>

              <div class="form-group mb-3">
                <label for="edit-type" class="form-label">Equipment Type</label>
                <select id="edit-type" class="form-select form-control">
                  <option value="" disabled>Select a Type</option>
                </select>
              </div>

              <div class="modal-footer">
                <button
                  id="saveEqpt"
                  type="submit"
                  class="btn btn-success w-100 submit-btn"
                >
                  Save
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Assign Modal -->
    <div
      class="modal fade"
      id="assign-modal"
      tabindex="-1"
      aria-labelledby="assignModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="assignModalLabel">Assign Equipment</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body">
            <form id="assign-form">
              <div class="form-group mb-3">
                <label for="assign-name" class="form-label">Assign To</label>
                <select
                  id="assign-name"
                  class="form-select form-control"
                  required
                >
                  <option value="" disabled>Select a User</option>
                </select>
              </div>

              <div class="form-group mb-3">
                <label for="assign-task" class="form-label">Relate Task</label>
                <select id="assign-task" class="form-select form-control">
                  <option value="" disabled>Select a Task</option>
                </select>
              </div>

              <div class="form-group mb-3" hidden>
                <input
                  type="text"
                  id="assign-eqpt-id"
                  class="form-control"
                  disabled
                />
                <input
                  type="text"
                  id="assign-eqpt-typeid"
                  class="form-control"
                  disabled
                />
              </div>

              <div class="form-group mb-3">
                <label for="assign-eqpt-code" class="form-label"
                  >Equipment Code</label
                >
                <input
                  type="text"
                  id="assign-eqpt-code"
                  class="form-control"
                  disabled
                />
              </div>

              <div class="form-group mb-3">
                <label for="assign-eqpt-name" class="form-label"
                  >Equipment Name</label
                >
                <input
                  type="text"
                  id="assign-eqpt-name"
                  class="form-control"
                  disabled
                />
              </div>

              <div class="form-group mb-3">
                <label for="assign-eqpt-type" class="form-label"
                  >Equipment Type</label
                >
                <input
                  type="text"
                  id="assign-eqpt-type"
                  class="form-control"
                  disabled
                />
              </div>

              <div class="modal-footer">
                <button
                  id="assignEqpt"
                  type="submit"
                  class="btn btn-success w-100 submit-btn"
                >
                  Assign
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Retrun Modal -->
    <div
      class="modal fade"
      id="return-modal"
      tabindex="-1"
      aria-labelledby="assignModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="returnModalLabel">Return Equipment</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body">
            <form id="return-form">
              <div class="form-group mb-3">
                <label for="return-name" class="form-label">Return From</label>
                <input
                  type="text"
                  id="return-name"
                  class="form-control"
                  disabled
                />
              </div>

              <div class="form-group mb-3">
                <label for="return-task" class="form-label">Relate Task</label>
                <select id="return-task" class="form-select form-control">
                  <option value="" disabled>Select a Task</option>
                </select>
              </div>

              <div class="form-group mb-3">
                <label for="return-assign-date" class="form-label"
                  >Assigned Date</label
                >
                <input
                  type="text"
                  id="return-assign-date"
                  class="form-control"
                  disabled
                />
              </div>

              <div class="form-group mb-3" hidden>
                <input
                  type="text"
                  id="return-user-id"
                  class="form-control"
                  disabled
                />
                <input
                  type="text"
                  id="return-eqpt-id"
                  class="form-control"
                  disabled
                />
                <input
                  type="text"
                  id="return-eqpt-typeid"
                  class="form-control"
                  disabled
                />
                <input
                  type="text"
                  id="return-id"
                  class="form-control"
                  disabled
                />
              </div>

              <div class="form-group mb-3">
                <label for="return-eqpt-code" class="form-label"
                  >Equipment Code</label
                >
                <input
                  type="text"
                  id="return-eqpt-code"
                  class="form-control"
                  disabled
                />
              </div>

              <div class="form-group mb-3">
                <label for="return-eqpt-name" class="form-label"
                  >Equipment Name</label
                >
                <input
                  type="text"
                  id="return-eqpt-name"
                  class="form-control"
                  disabled
                />
              </div>

              <div class="modal-footer">
                <button
                  id="returnEqpt"
                  type="submit"
                  class="btn btn-success w-100 submit-btn"
                >
                  Return
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <%- include('../partials/footer-simple') %>
  </body>
  <!-- Bootstrap JS and dependencies -->
  <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <script src="/js/mgmt-equipment.js" type="module"></script>
</html>
