<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Equipment Management</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Navbar -->
    <%- include('../partials/navbar') %>

    <div class="container mt-4">
      <h1>Equipment Management</h1>

      <!-- Search Section -->
      <div class="mb-3">
        <div class="row">
          <div class="col-md-4">
            <input
              type="text"
              id="search-field"
              class="form-control"
              placeholder="Search by name"
            />
          </div>
          <div class="col-md-4">
            <button id="new-equipment-btn" class="btn btn-success w-100">
              Add New Equipment
            </button>
          </div>
          <div class="col-md-2">
            <button id="process-btn" class="btn btn-primary w-100">
              Process
            </button>
          </div>
        </div>
      </div>

      <!-- Equipment Table -->
      <table class="table table-bordered">
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Type</th>
            <th>Assigned To</th>
            <th>Occupied</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="equipment-table-body"></tbody>
      </table>
    </div>

    <!-- Edit Modal -->
    <div
      class="modal fade"
      id="edit-modal"
      tabindex="-1"
      aria-labelledby="editModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="editModalLabel">Edit Equipment</h5>
            <button
              type="button"
              class="btn-close"
              data-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body">
            <form id="edit-form">
              <input type="hidden" id="edit-id" />
              <div class="mb-3">
                <label for="edit-name" class="form-label">Name</label>
                <input
                  type="text"
                  id="edit-name"
                  class="form-control"
                  required
                />
              </div>
              <div class="mb-3">
                <label for="edit-assigned-to" class="form-label"
                  >Assigned To</label
                >
                <input
                  type="number"
                  id="edit-assigned-to"
                  class="form-control"
                  required
                />
              </div>
              <div class="mb-3">
                <label for="edit-occupied" class="form-label">Occupied</label>
                <select id="edit-occupied" class="form-select">
                  <option value="true">Yes</option>
                  <option value="false">No</option>
                </select>
              </div>
              <button type="submit" class="btn btn-success w-100">Save</button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Add New Equipment Modal -->
    <div
      class="modal fade"
      id="new-equipment-modal"
      tabindex="-1"
      aria-labelledby="newEquipmentModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="newEquipmentModalLabel">
              Add New Equipment
            </h5>
            <button
              type="button"
              class="btn-close"
              data-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body">
            <form id="new-equipment-form">
              <div class="mb-3">
                <label for="new-name" class="form-label">Name</label>
                <input
                  type="text"
                  id="new-name"
                  class="form-control"
                  required
                />
              </div>
              <div class="mb-3">
                <label for="new-type" class="form-label">Type</label>
                <input
                  type="number"
                  id="new-type"
                  class="form-control"
                  required
                />
              </div>
              <div class="mb-3">
                <label for="new-assigned-to" class="form-label"
                  >Assigned To</label
                >
                <input
                  type="number"
                  id="new-assigned-to"
                  class="form-control"
                />
              </div>
              <div class="mb-3">
                <label for="new-occupied" class="form-label">Occupied</label>
                <select id="new-occupied" class="form-select">
                  <option value="true">Yes</option>
                  <option value="false">No</option>
                </select>
              </div>
              <button type="submit" class="btn btn-primary w-100">
                Add Equipment
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <%- include('../partials/footer-simple') %>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script type="module" src="/js/mgmt-equipment.js"></script>
  </body>
</html>
