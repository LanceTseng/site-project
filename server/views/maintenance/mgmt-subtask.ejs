<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Subtask Management</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- Navbar -->
    <%- include('../partials/navbar') %>

    <!-- Content -->
    <div class="container mt-4">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Subtasks for: <span id="taskName"></span></h2>

        <div class="d-flex gap-2">
          <button
            type="button"
            class="btn btn-dark btn-primary-add shadow-sm"
            id="addSubtaskButton"
          >
            Add Subtask
          </button>

          <a
            href="/mgmt-task"
            class="btn btn-secondary back-btn btn-primary-add shadow-sm"
            id="backToTaskBtn"
          >
            Back to Task
          </a>
        </div>
      </div>

      <div class="table-container shadow-sm p-3 bg-white rounded">
        <!-- Subtask Table -->
        <table class="table table-hover mt-4" id="subtaskTable">
          <thead>
            <tr>
              <th>ID</th>
              <th>Subtask Name</th>
              <th>Description</th>
              <th>Document</th>
              <th>Documnet Upload</th>
              <th>Device</th>
              <th>Training Module</th>
              <th>Handover</th>
              <th>Survey/Interview</th>
              <th>Enable</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
    <!-- Add/Edit Subtask Modal -->
    <div
      class="modal fade"
      id="addSubtaskModal"
      tabindex="-1"
      role="dialog"
      aria-labelledby="addSubtaskModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-lg" role="document">
        <!-- Optional: modal-lg for wider modal -->
        <div class="modal-content shadow">
          <div class="modal-header">
            <h5 class="modal-title" id="addSubtaskModalLabel">Add Subtask</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
            ></button>
          </div>
          <div class="modal-body">
            <form id="addSubtaskForm">
              <!-- Hidden Subtask ID -->
              <input type="hidden" id="subtaskId" />

              <!-- Subtask Name -->
              <div class="form-group mb-3">
                <label for="subtaskName"
                  >Subtask Name <span class="text-danger">*</span></label
                >
                <input
                  type="text"
                  class="form-control"
                  id="subtaskName"
                  required
                />
              </div>

              <!-- Description -->
              <div class="form-group mb-3">
                <label for="subtaskDescription"
                  >Description <span class="text-danger">*</span></label
                >
                <textarea
                  class="form-control"
                  id="subtaskDescription"
                  rows="3"
                  required
                ></textarea>
              </div>

              <!-- Row for related items -->
              <div class="row">
                <div class="col-md-6">
                  <!-- Document Template -->
                  <div class="form-group mb-3">
                    <label for="documentId">Document Template</label>
                    <select class="form-control" id="documentId">
                      <option value="" selected>None</option>
                      <!-- Allow None -->
                      <!-- Options populated by JS -->
                    </select>
                  </div>
                </div>
                <div class="col-md-6">
                  <!-- File Requirement (Upload Required) -->
                  <div class="form-group mb-3">
                    <label for="fileRequirement"
                      >Document Upload Required?</label
                    >
                    <select class="form-control" id="fileRequirement">
                      <option value="0">No</option>
                      <option value="1">Yes</option>
                    </select>
                    <small class="form-text text-muted"
                      >Does the user need to upload a file for this step?</small
                    >
                  </div>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6">
                  <!-- Device Type -->
                  <div class="form-group mb-3">
                    <label for="deviceId">Device Type</label>
                    <select class="form-control" id="deviceId">
                      <option value="" selected>None</option>
                      <!-- Allow None -->
                      <!-- Options populated by JS -->
                    </select>
                  </div>
                </div>
                <div class="col-md-6">
                  <!-- Training Module -->
                  <div class="form-group mb-3">
                    <label for="trainingModuleId">Training Module</label>
                    <select class="form-control" id="trainingModuleId">
                      <option value="" selected>None</option>
                      <!-- Allow None -->
                      <!-- Options populated by JS -->
                    </select>
                  </div>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6">
                  <!-- Survey / Interview -->
                  <div class="form-group mb-3">
                    <label for="surveyId">Survey / Interview</label>
                    <select class="form-control" id="surveyId">
                      <option value="" selected>None</option>
                      <!-- Allow None -->
                      <!-- Options populated by JS -->
                    </select>
                  </div>
                </div>
                <div class="col-md-6">
                  <!-- Handover -->
                  <div class="form-group mb-3">
                    <label for="handoverId">Handover Required?</label>
                    <select class="form-control" id="handoverId">
                      <option value="0">No</option>
                      <option value="1">Yes</option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- Hidden Interview ID (If needed specifically, otherwise handled by Survey/Interview dropdown) -->
              <input type="hidden" id="interviewId" />
              <!--
          <div class="form-group mb-3" hidden>
            <label for="interviewId">Interview</label>
            <select class="form-control" id="interviewId">
              <option value="" disabled selected>Select an interview</option>
            </select>
          </div>
          -->

              <div class="row">
                <div class="col-md-6">
                  <!-- Enable -->
                  <div class="form-group mb-3">
                    <label for="enable">Enable Subtask?</label>
                    <select class="form-control" id="enable">
                      <option value="true">Yes</option>
                      <option value="false">No</option>
                    </select>
                  </div>
                </div>
              </div>
            </form>
          </div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-dark"
              id="saveSubtask"
              data-mode=""
            >
              Save Subtask
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <%- include('../partials/footer-simple') %>

    <!-- JS -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script type="module" src="/js/mgmt-subtask.js"></script>
  </body>
</html>
<style>
  .table-container {
    max-height: 600px;
    overflow-y: auto;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    border-radius: 10px;
  }
  thead th {
    position: sticky;
    top: 0;
    background: #000000 !important;
    color: white !important;
    z-index: 10;
  }
  .btn-primary-add {
    border-radius: 6px;
    font-size: 1rem;
    padding: 10px 15px;
  }
  .modal-content {
    border-radius: 8px;
  }
  .form-control {
    border-radius: 6px;
  }
  #taskName {
    color: darkslategray;
  }
</style>
