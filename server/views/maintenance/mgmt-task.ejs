<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Task Setting</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      .parent {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
        padding: 20px;
      }
      .table-container {
        max-height: 600px;
        overflow-y: auto;
        border-radius: 10px;
      }
      thead th {
        position: sticky;
        top: 0;
        background: white;
        z-index: 10;
      }
    </style>
  </head>
  <body>
    <!-- Navbar -->
    <%- include('../partials/navbar') %> <%- include('./mgmt-task-nav') %>

    <!-- Content -->
    <div class="container mt-4">
      <div class="d-flex justify-content-between align-items-center">
        <h3 class="mb-3">Task List</h3>
        <button
          type="button"
          class="btn btn-modern"
          data-bs-toggle="modal"
          data-bs-target="#taskModal"
        >
          <i class="fas fa-plus"></i> Create Task
        </button>
      </div>

      <!-- Task Table -->
      <div class="table-container shadow-sm p-3 bg-white rounded">
        <table class="table table-hover" id="taskTable">
          <thead>
            <tr>
              <th>ID</th>
              <th>Task Name</th>
              <th>Task Description</th>
              <th>Task Group</th>
              <th hidden>group_id</th>
              <th>Created Date</th>
              <th>Last Updated Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <!-- Data will be dynamically populated here -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Task Modal -->
    <div
      class="modal fade"
      id="taskModal"
      tabindex="-1"
      aria-labelledby="taskModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="taskModalLabel">Create Task</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
            ></button>
          </div>
          <div class="modal-body">
            <form id="taskForm">
              <div class="mb-3">
                <label for="taskName" class="form-label">Task Name</label>
                <input
                  type="text"
                  class="form-control"
                  id="taskName"
                  required
                />
              </div>

              <div class="mb-3">
                <label for="taskDescription" class="form-label"
                  >Task Description</label
                >
                <textarea
                  class="form-control"
                  id="taskDescription"
                  rows="3"
                  required
                ></textarea>
              </div>

              <div class="mb-3">
                <label for="taskGroupId" class="form-label">Task Group</label>
                <select
                  class="form-select form-control"
                  id="taskGroupId"
                  required
                ></select>
              </div>
            </form>
          </div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-secondary"
              data-bs-dismiss="modal"
            >
              Close
            </button>
            <button type="button" class="btn btn-modern" id="saveTask">
              Save Task
            </button>
          </div>
        </div>
      </div>
    </div>
    <!-- Footer -->
    <%- include('../partials/footer-simple') %>

    <!-- Bootstrap JS and jQuery -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Custom JS -->
    <script src="/js/mgmt-task.js" type="module"></script>
  </body>
</html>
<style>
  body {
    background-color: #f8f9fa;
  }

  table {
    border-collapse: collapse;
    width: 100%;
    background: white;
  }
  thead th {
    position: sticky;
    top: 0;
    background: #000000;
    color: white;
    z-index: 10;
  }
  tbody tr:hover {
    background-color: #f1f1f1;
  }
  .btn-modern {
    background: #007bff;
    color: white;
    border: none;
    transition: background 0.3s ease;
  }
  .btn-modern:hover {
    background: #00000069;
  }
  .modal-content {
    border-radius: 12px;
  }
</style>
