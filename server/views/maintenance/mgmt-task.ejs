<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Task Setting</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Navbar -->
    <%- include('../partials/navbar') %> <%- include('./mgmt-task-nav') %>

    <!-- Content -->
    <div class="container mt-4">
      <h3>Task List</h3>

      <!-- Create Button -->
      <button
        type="button"
        class="btn btn-primary"
        data-toggle="modal"
        data-target="#taskModal"
      >
        Create Task
      </button>

      <!-- Task Table -->
      <table class="table table-bordered mt-4" id="taskTable">
        <thead>
          <tr>
            <th>ID</th>
            <th>Task Name</th>
            <th>Task Description</th>
            <th>Task Group</th>
            <th hidden>group_id</th>
            <th>Created Date</th>
            <th>Last Updated Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <!-- Data will be dynamically populated here -->
        </tbody>
      </table>
    </div>

    <!-- Task Modal -->
    <div
      class="modal fade"
      id="taskModal"
      tabindex="-1"
      role="dialog"
      aria-labelledby="taskModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="taskModalLabel">Create Task</h5>
            <button
              type="button"
              class="close"
              data-dismiss="modal"
              aria-label="Close"
            >
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="modal-body">
            <form id="taskForm">
              <!-- Form Fields for Task -->
              <div class="form-group">
                <label for="taskName">Task Name</label>
                <input
                  type="text"
                  class="form-control"
                  id="taskName"
                  required
                />
              </div>

              <div class="form-group">
                <label for="taskDescription">Task Description</label>
                <input
                  type="text"
                  class="form-control"
                  id="taskDescription"
                  required
                />
              </div>
              <div class="form-group">
                <label for="taskGroupId">Task Group</label>
                <select class="form-control" id="taskGroupId" required></select>
              </div>
            </form>
          </div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-secondary"
              data-dismiss="modal"
            >
              Close
            </button>
            <button type="button" class="btn btn-primary" id="saveTask">
              Save Task
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <%- include('../partials/footer-simple') %>

    <!-- Bootstrap JS and jQuery -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Custom JS -->
    <script src="/js/mgmt-task.js" type="module"></script>

  </body>
</html>
