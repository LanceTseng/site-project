<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Offboarding Employee</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Font Awesome CSS -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />

    <!-- Custom CSS -->
  </head>
  <body>
    <!-- Navbar -->
    <%- include('../partials/navbar') %>

    <!-- Main Content -->
    <div class="container mt-5">
      <h2 class="text-center mb-4">Employee Offboarding</h2>
      <div class="row">
        <div class="col-md-12">
          <div class="mb-3">
            <div class="input-group">
              <span class="input-group-text">
                <i class="fas fa-search"></i>
              </span>
              <input
                type="text"
                id="searchInput"
                class="form-control"
                placeholder="Search Employee..."
              />
            </div>
          </div>
          <div class="table-container shadow-sm p-3 bg-white rounded">
            <table class="table table-striped table-hover">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>First Name</th>
                  <th>Last Name</th>
                  <th>Status</th>
                  <th>Department</th>
                  <th class="text-center">Action</th>
                </tr>
              </thead>
              <tbody id="employeeTableBody">
                <!-- Data will be loaded here -->
                <tr>
                  <td colspan="6" class="text-center">
                    <div class="spinner-border" role="status">
                      <span class="visually-hidden">Loading...</span>
                    </div>
                    <p>Loading employees...</p>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Offboard Modal -->
    <div
      class="modal fade"
      id="offboardModal"
      tabindex="-1"
      aria-labelledby="offboardModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header bg-light">
            <h5 class="modal-title" id="offboardModalLabel">
              Offboard Employee
            </h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body">
            <p>
              Are you sure you want to offboard
              <strong id="employeeName"></strong>?
            </p>
            <input type="hidden" id="employeeId" />

            <!-- Offboarding Date Selection -->
            <div class="mb-3">
              <label for="offboardDate" class="form-label"
                >Select Offboarding Date</label
              >
              <input
                type="date"
                class="form-control"
                id="offboardDate"
                required
              />
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-danger" id="confirmOffboard">
              Offboard
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <%- include('../partials/footer-simple') %>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Custom JS -->
    <script src="/js/offboard.js" type="module"></script>
  </body>
</html>
<style>
  /* Custom CSS for Employee Offboarding */

  /* Theme Variables */
  :root {
    --body-bg: #f8f9fa;
    --primary-color: #343a40;
    --success-color: #28a745;
    --danger-color: #dc3545;
    --text-light: #ffffff;
    --text-dark: #343a40;
    --border-color: #dee2e6;
    --box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    --border-radius: 0.5rem;
    --transition-duration: 0.3s;
  }

  body {
    font-family: "Arial", sans-serif;
    background-color: var(--body-bg);
    color: var(--text-dark);
  }

  .container {
    max-width: 1200px;
  }

  h2 {
    color: var(--text-dark);
    margin-bottom: 1.5rem;
  }

  /* Table Styling */
  .table-container {
    border-radius: var(--border-radius);
    overflow: hidden;
    border: 1px solid var(--border-color);
  }

  .table {
    margin-bottom: 0;
  }

  .table thead th {
    background-color: var(--text-dark);
    color: var(--text-light);
    border-bottom: 2px solid #495057;
    vertical-align: middle;
  }

  .table tbody td {
    vertical-align: middle;
  }

  .table-striped tbody tr:nth-of-type(odd) {
    background-color: rgba(0, 0, 0, 0.05);
  }

  .table-hover tbody tr:hover {
    background-color: rgba(0, 0, 0, 0.075);
  }

  /* Search Input Styling */
  .input-group-text {
    background-color: var(--primary-color);
    color: var(--text-light);
    border: 1px solid var(--primary-color);
  }

  /* Button Styling */
  .btn-danger {
    background-color: var(--danger-color);
    border-color: var(--danger-color);
    transition: background-color var(--transition-duration),
      border-color var(--transition-duration), transform 0.2s ease-in-out;
  }

  .btn-danger:hover {
    background-color: #bb2d3b;
    border-color: #bbad2b3b;
    transform: translateY(-2px);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
  }

  /* Modal Styling */
  .modal-content {
    border-radius: var(--border-radius);
    border: none;
    box-shadow: var(--box-shadow);
  }

  .modal-header {
    background-color: #f8f9fa;
    border-bottom: none;
  }

  .modal-title {
    color: var(--text-dark);
  }

  /* Center table text for action buttons */
  .text-center {
    text-align: center;
  }
</style>
