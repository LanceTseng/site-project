<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Excel Upload</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  </head>
  <body>
    <h2>Upload Excel File</h2>
    <input type="file" id="excelFileInput" />
    <button onclick="uploadExcel()">Upload</button>

    <div>
      <div class="table-container">
        <table class="table table-striped table-hover">
          <thead>
            <tr>
              <th>User Name</th>
              <th>Email</th>
            </tr>
          </thead>
          <tbody id="tableBody">
            <!-- Data will be loaded dynamically -->
          </tbody>
        </table>
      </div>
    </div>

    <script>
      function uploadExcel() {
        const fileInput = document.getElementById("excelFileInput");
        if (!fileInput.files.length) {
          alert("Please select an Excel file.");
          return;
        }

        const file = fileInput.files[0];
        const reader = new FileReader();

        reader.onload = function (event) {
          const data = new Uint8Array(event.target.result);
          const workbook = XLSX.read(data, { type: "array" });

          // Get the first sheet
          const sheetName = workbook.SheetNames[0];
          const sheet = workbook.Sheets[sheetName];

          // Convert sheet data to JSON
          const jsonData = XLSX.utils.sheet_to_json(sheet);

          axios
            .post("http://localhost:3000/api/upload-file-excel", jsonData)
            .then((response) => {
              alert("Upload successful!");
              const tableBody = document.getElementById("tableBody");
              tableBody.innerHTML = ""; // Clear existing rows
              console.log(response.data);

              // Fix: Access the correct array inside response.data
              response.data.data.forEach((row) => {
                const tr = document.createElement("tr");
                const userNameTd = document.createElement("td");
                const emailTd = document.createElement("td");

                // Fix: Use correct property names (case-sensitive)
                userNameTd.textContent = row.user || "N/A";
                emailTd.textContent = row.mail || "N/A";

                tr.appendChild(userNameTd);
                tr.appendChild(emailTd);
                tableBody.appendChild(tr);
              });
            })
            .catch((error) => console.error("Upload failed:", error));
        };

        reader.readAsArrayBuffer(file);
      }
    </script>
  </body>
</html>
