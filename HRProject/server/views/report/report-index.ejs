<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>

    <!-- Bootstrap 5 -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    />
    <!-- Font Awesome Icons -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <!-- Custom CSS -->
     
  </head>

  <body>
    <%- include('../partials/navbar') %>

    <div class="container mt-5">
      <h2 class="text-center fw-bold mb-4">Dashboard</h2>

      <div class="row g-4">
        <!-- User Task -->
        <div class="col-md-4" id="report-user-task">
          <div class="card menu-card" data-link="/report-user-task">
            <div class="card-body text-center">
              <i class="fa-solid fa-tasks text-primary fa-3x mb-3"></i>
              <h5 class="card-title">User Task</h5>
              <a href="/report-user-task" class="btn btn-outline-primary"
                >View Task</a
              >
            </div>
          </div>
        </div>

        <!-- Equipment -->
        <div class="col-md-4" id="report-equipment">
          <div class="card menu-card" data-link="equipment.html">
            <div class="card-body text-center">
              <i class="fa-solid fa-tools text-success fa-3x mb-3"></i>
              <h5 class="card-title">Equipment</h5>
              <a href="#" class="btn btn-outline-success">View Equipment</a>
            </div>
          </div>
        </div>

        <!-- User / Employee -->
        <div class="col-md-4" id="report-user-employee">
          <div class="card menu-card" data-link="/report-profile">
            <div class="card-body text-center">
              <i class="fa-solid fa-user-tie text-warning fa-3x mb-3"></i>
              <h5 class="card-title">Profile</h5>
              <a href="/report-profile" class="btn btn-outline-warning"
                >View Users</a
              >
            </div>
          </div>
        </div>

        <!-- Document -->
        <div class="col-md-4" id="report-document">
          <div class="card menu-card" data-link="document.html">
            <div class="card-body text-center">
              <i class="fa-solid fa-file-alt text-info fa-3x mb-3"></i>
              <h5 class="card-title">Document</h5>
              <a href="#" class="btn btn-outline-info">View Documents</a>
            </div>
          </div>
        </div>

        <!-- Survey -->
        <div class="col-md-4" id="report-survey">
          <div class="card menu-card" data-link="employee.html">
            <div class="card-body text-center">
              <i class="fa-solid fa-poll text-danger fa-3x mb-3"></i>
              <h5 class="card-title">Survey</h5>
              <a href="#" class="btn btn-outline-danger">Take Survey</a>
            </div>
          </div>
        </div>

        <!-- Training Module -->
        <div class="col-md-4" id="report-training">
          <div class="card menu-card" data-link="training.html">
            <div class="card-body text-center">
              <i
                class="fa-solid fa-chalkboard-teacher text-primary fa-3x mb-3"
              ></i>
              <h5 class="card-title">Training</h5>
              <a href="#" class="btn btn-outline-primary">Start Training</a>
            </div>
          </div>
        </div>

        <!-- Goals -->
        <div class="col-md-4 mx-auto" id="report-goal">
          <div class="card menu-card" data-link="/report-goal">
            <div class="card-body text-center">
              <i class="fa-solid fa-bullseye text-secondary fa-3x mb-3"></i>
              <h5 class="card-title">Goals</h5>
              <a href="/report-goal" class="btn btn-outline-secondary"
                >View Goals</a
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    <%- include('../partials/footer-simple') %>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Custom JS -->
   
    <script>
      $(document).ready(function () {
        $(".menu-card").click(function () {
          const link = $(this).data("link");
          if (link) {
            window.location.href = link;
          }
        });
      });
    </script>
  </body>
</html>
<style>
  body {
    background-color: #f8f9fa;
  }

  .menu-card {
    border-radius: 12px;
    box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
  }

  .menu-card:hover {
    transform: translateY(-5px);
    box-shadow: 0px 6px 12px rgba(0, 0, 0, 0.15);
  }

  .menu-card .card-body {
    padding: 30px;
  }

  .menu-card i {
    display: block;
    margin-bottom: 10px;
  }
</style>
