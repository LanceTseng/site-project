<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Training Module</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
  </head>

  <body>
    <!-- Navbar -->
    <%- include('../partials/navbar') %>
    <div class="parent">
      <div class="mb-4">
        <h3>Training Filter</h3>
        <div class="form-group" hidden>
          <label for="searchLineId">Training Name</label>
          <input
            type="text"
            id="searchLineId"
            class="form-control"
            placeholder="Enter Training Name"
          />
        </div>
        <div class="form-group">
          <label for="searchTrainingName">Training Name</label>
          <input
            type="text"
            id="searchTrainingName"
            class="form-control"
            placeholder="Enter Training Name"
          />
        </div>
        <div class="form-group">
          <label for="searchUserName">User Name</label>
          <input
            type="text"
            id="searchUserName"
            class="form-control"
            placeholder="Enter User Name"
          />
        </div>
        <div class="form-group">
          <label for="searchDepartment">Training Department</label>
          <select id="searchDepartment" class="form-control">
            <option value="" selected>Select an Option</option>
          </select>
        </div>
        <div class="form-group">
          <label for="searchStatus">Training Status</label>
          <select id="searchStatus" class="form-control">
            <option value="" selected>Select an Option</option>
          </select>
        </div>
        <button id="processQuery" class="btn btn-primary">Process Query</button>
      </div>
      <div>
        <h2 class="text-center">Training Module</h2>

        <div class="table-container">
          <table class="table table-striped table-hover">
            <thead>
              <tr>
                <th>Trained User</th>
                <th>Training Name</th>
                <th>Training Status</th>
                <th>Verify Department</th>
                <th>Verify By</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="trainingTableBody">
              <!-- Data will be loaded dynamically -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <!-- Swal.fire("Error", `Please fill in all required fields.`, "error");
      Swal.fire("Success", `Equipment ${mode}ed successfully!`, "success");
      -->

    <!-- Footer -->
    <%- include('../partials/footer-simple') %>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/report-user-training.js" type="module"></script>
  </body>
</html>
<style>
  .parent {
    display: grid;
    grid-template-columns: 0.5fr 3fr;
    gap: 20px;
    padding: 20px;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    background: white;
  }
  .table-container {
    max-height: 600px;
    overflow-y: auto;
    border-radius: 10px;
  }
  thead th {
    position: sticky;
    top: 0;
    background: #000000 !important;
    color: white !important;
    z-index: 10;
  }
  tbody tr:hover {
    background-color: #f1f1f1;
  }
</style>
