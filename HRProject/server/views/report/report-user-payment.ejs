<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Employee Payment</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <!-- Font Awesome CSS -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/report-user-payment.css" />
  </head>

  <body>
    <!-- Navbar -->
    <%- include('../partials/navbar') %>

    <div class="container-fluid">
      <!-- Search Section -->
      <div class="row justify-content-center mb-4 mt-3">
        <div class="col-lg-10">
          <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white">
              <i class="fas fa-search mr-2"></i>Search Employee Payments
            </div>
            <div class="card-body">
              <form id="search-form">
                <div class="form-row align-items-end">
                  <div class="col-md-3 form-group">
                    <label for="searchName">Employee Name</label>
                    <input
                      type="text"
                      id="searchName"
                      class="form-control form-control-sm"
                      placeholder="Enter User Name"
                    />
                  </div>
                  <div class="col-md-3 form-group">
                    <label for="searchDepartment">Department</label>
                    <select
                      id="searchDepartment"
                      class="form-control form-control-sm"
                    >
                      <option value="" selected>Select a Department</option>
                    </select>
                  </div>
                  <div class="col-md-3 form-group">
                    <label for="searchEmpStatus">Status</label>
                    <select
                      id="searchEmpStatus"
                      class="form-control form-control-sm"
                    >
                      <option value="" selected>Select a Status</option>
                    </select>
                  </div>
                  <div class="col-md-3 form-group">
                    <button
                      type="submit"
                      class="btn btn-dark btn-block btn-sm"
                      id="btnSearch"
                    >
                      <i class="fas fa-search mr-1"></i> Search
                    </button>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>

      <!-- Table Section -->
      <div class="row justify-content-center">
        <div class="col-lg-12">
          <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white">
              <i class="fas fa-money-bill-wave mr-2"></i>Employee Payments
            </div>
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-striped table-hover">
                  <thead class="thead-dark">
                    <tr>
                      <th>User ID</th>
                      <th>First Name</th>
                      <th>Last Name</th>
                      <th>Status</th>
                      <th>Payment Type</th>
                      <th>Annual Salary</th>
                      <th>Weekly Work Hours</th>
                      <th>Termination Pay</th>
                      <th>Created At</th>
                      <th>Updated At</th>
                      <th class="text-center">Action</th>
                    </tr>
                  </thead>
                  <tbody id="paymentTableBody">
                    <!-- Data will be loaded dynamically -->
                    <tr>
                      <td colspan="11" class="text-center">
                        <div class="spinner-border" role="status">
                          <span class="sr-only">Loading...</span>
                        </div>
                        <p>Loading employee payments...</p>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <%- include('../partials/footer-simple') %>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/report-user-payment.js" type="module"></script>
  </body>
</html>
<style>
  body {
    font-family: Arial, sans-serif;
    background-color: #f8f9fa;
  }

  .container-fluid {
    padding: 15px;
  }

  /* Card styling */
  .card {
    border: none;
    margin-bottom: 1.5rem;
    border-radius: 0.5rem;
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
  }

  .card-header {
    font-weight: bold;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.125);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .card-body {
    padding: 1.25rem;
  }

  /* Table styling */
  .table thead th {
    background-color: #343a40;
    color: #fff;
    border-bottom: 2px solid #495057;
    font-size: 0.9rem;
  }

  .table tbody td {
    font-size: 0.85rem;
    vertical-align: middle;
  }

  .table-striped tbody tr:nth-of-type(odd) {
    background-color: rgba(0, 0, 0, 0.05);
  }

  .table-hover tbody tr:hover {
    background-color: rgba(0, 0, 0, 0.075);
  }

  /* Form styling */
  .form-control-sm {
    font-size: 0.8rem;
  }

  /* Button styling */
  .btn-primary {
    background-color: #007bff;
    border-color: #007bff;
  }

  .btn-primary:hover {
    background-color: #0069d9;
    border-color: #0062cc;
  }

  /* Text alignment for action buttons */
  .text-center {
    text-align: center;
  }
</style>
