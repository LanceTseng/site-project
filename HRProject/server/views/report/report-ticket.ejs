<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ticket Request</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
  </head>

  <body>
    <!-- Navbar -->
    <%- include('../partials/navbar') %>
    <div class="parent">
      <!-- section 1 -->
      <div>
        <h2 class="text-center">Search Tickets</h2>
        <form id="search-form">
          <div class="form-group">
            <label for="searchTicket" class="font-weight-bold">Topic</label>
            <input
              type="text"
              id="searchTicket"
              class="form-control"
              placeholder="Enter Task Name"
            />
          </div>
          <div class="form-group">
            <label for="searchDepartment" class="font-weight-bold"
              >Department</label
            >
            <select id="searchDepartment" class="form-control">
              <option value="" disabled selected>Select a Department</option>
            </select>
          </div>
          <div class="form-group">
            <label for="searchTicketStatus" class="font-weight-bold"
              >Status</label
            >
            <select id="searchTicketStatus" class="form-control">
              <option value="" disabled selected>Select a Status</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary" id="search">
            Search
          </button>
        </form>
      </div>

      <!-- section 2 -->
      <div>
        <h2 class="text-center">Ticket Forum</h2>
        <div class="container mt-4"></div>
        <button
          type="button"
          class="btn btn-primary mb-3"
          data-toggle="modal"
          data-target="#ticketModal"
        >
          <i class="fa fa-plus"></i> Create Ticket
        </button>

        <h5 class="mt-4">Submitted Tickets</h5>
        <div id="ticketList" class="mt-2">
          <div class="table-container">
            <table class="table table-striped table-hover">
              <thead>
                <tr>
                  <th>Ticket#</th>
                  <th>Ticket Topic</th>
                  <th>Ticket Status</th>
                  <th>Department</th>
                  <th>Creaated By</th>
                  <th>Created Date</th>
                </tr>
              </thead>
              <tbody id="ticketTableBody">
                <!-- Data will be loaded dynamically -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- section 3 -->
      <div>
        <div class="container mt-4">
          <h5 class="mt-4">Ticket Details</h5>
        </div>
        <!-- Ticket Information -->
        <div class="card p-3 mb-3">
          <h5 id="ticketTitle" class="font-weight-bold">[Ticket Topic]</h5>
          <p id="ticketDescription" class="text-muted">[Ticket Description]</p>
          <p id="ticketId" class="text-muted" hidden></p>
        </div>

        <div>
          <h6 class="mt-4">Action</h6>
          <button type="button" class="btn btn-info btn-update-status" data-status="1" id="btnReOpen">
            ReOpen
          </button>
          <button type="button" class="btn btn-warning btn-update-status" data-status="2" id="btnProcessing">
            Processing
          </button>
          <button type="button" class="btn btn-success btn-update-status" data-status="3" id="btnCompleted">
            Completed
          </button>
          <button type="button" class="btn btn-danger btn-update-status" data-status="4" id="btnCancel">
            Cancelled
          </button>
          <button type="button" class="btn btn-danger btn-update-status" data-status="5" id="btnReject">
            Reject
          </button>
        </div>
        <!-- Comment Section -->
        <h6 class="mt-4">Response</h6>
        <div id="commentsSection">
          <!-- Existing Comments Will Be Loaded Here -->
        </div>

        <!-- Comment Input -->
        <div class="card p-3 mt-3" id="response-area">
          <h6>Reply</h6>
          <textarea
            id="commentInput"
            class="form-control"
            rows="3"
            placeholder="Write a comment..."
          ></textarea>
          <button id="postComment" class="btn btn-primary mt-2">
            Post Reply
          </button>
        </div>
      </div>
    </div>

    <!-- Create Ticket Modal -->
    <div
      class="modal fade"
      id="ticketModal"
      tabindex="-1"
      aria-labelledby="ticketModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="ticketModalLabel">
              Create a New Ticket
            </h5>
            <button
              type="button"
              class="close"
              data-dismiss="modal"
              aria-label="Close"
            >
              <span>&times;</span>
            </button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label for="addTicketTitle" class="form-label">Title</label>
              <input
                type="text"
                class="form-control"
                id="addTicketTitle"
                placeholder="Enter ticket title"
              />
            </div>
            <div class="mb-3">
              <label for="addTicketDepartment" class="form-label"
                >Issue Department</label
              >
              <select id="addTicketDepartment" class="form-control" required>
                <option value="" disabled selected>Select a Department</option>
              </select>
            </div>
            <div class="mb-3">
              <label for="addTicketDescription" class="form-label"
                >Description</label
              >
              <textarea
                class="form-control"
                id="addTicketDescription"
                rows="3"
                placeholder="Describe your issue"
              ></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-secondary"
              data-dismiss="modal"
            >
              Cancel
            </button>
            <button id="submitTicket" class="btn btn-primary">
              Submit Ticket
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <%- include('../partials/footer-simple') %>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="js/report-ticket.js" type="module"></script>
  </body>
</html>
<style>
  .parent {
    display: grid;
    grid-template-columns: 1fr 2fr 2fr;
    gap: 20px;
    padding: 20px;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    background: white;
  }
  .table-container {
    max-height: 600px;
    overflow-y: auto;
    border-radius: 10px;
  }
  thead th {
    position: sticky;
    top: 0;
    background: #000000 !important;
    color: white !important;
    z-index: 10;
  }
  tbody tr:hover {
    background-color: #f1f1f1;
  }
</style>
