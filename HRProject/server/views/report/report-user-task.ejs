<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Offboarding Employee</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <!-- Font Awesome CSS -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <!-- Custom CSS -->
  </head>

  <body>
    <!-- Navbar -->
    <%- include('../partials/navbar') %>

    <div class="container-fluid">
      <div class="row">
        <!-- Filter Section -->
        <div class="col-md-4">
          <div class="card shadow-sm mt-3">
            <div class="card-header bg-secondary text-white">
              <i class="fas fa-filter mr-2"></i>Task Filter
            </div>
            <div class="card-body">
              <div class="form-group">
                <label for="taskFilter">Task Name</label>
                <input
                  type="text"
                  id="taskFilter"
                  class="form-control form-control-sm"
                  placeholder="Enter Task Name"
                />
              </div>
              <div class="form-group">
                <label for="userFilter">User Name</label>
                <input
                  type="text"
                  id="userFilter"
                  class="form-control form-control-sm"
                  placeholder="Enter User Name"
                />
              </div>
              <div class="form-group">
                <label for="taskGroupFilter">Task Group</label>
                <select
                  id="taskGroupFilter"
                  class="form-control form-control-sm"
                >
                  <option value="" selected>Select an Option</option>
                </select>
              </div>
              <button id="processQuery" class="btn btn-dark btn-block btn-sm">
                <i class="fas fa-search mr-1"></i>Process Query
              </button>
            </div>
          </div>
        </div>

        <!-- User Task Header Section -->
        <div class="col-md-8">
          <div class="card shadow-sm mt-3">
            <div class="card-header bg-secondary text-white">
              <i class="fas fa-tasks mr-2"></i>User Task Header
            </div>
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-striped table-hover">
                  <thead class="thead-dark">
                    <tr>
                      <th>User Name</th>
                      <th>Task Name</th>
                      <th>Task Description</th>
                      <th>Task Group</th>
                      <th>Status</th>
                      <th>Process Rate</th>
                      <th>Start Date</th>
                      <th>End Date</th>
                      <th>Last Updated</th>
                      <th class="text-center">Action</th>
                    </tr>
                  </thead>
                  <tbody id="userTaskHeaderList">
                    <!-- Loading indicator -->
                    <tr>
                      <td colspan="10" class="text-center">
                        <div class="spinner-border" role="status">
                          <span class="sr-only">Loading...</span>
                        </div>
                        <p>Loading task headers...</p>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- User Task Detail Section -->
      <div class="row">
        <div class="col-md-12">
          <div class="card shadow-sm mt-3">
            <div class="card-header bg-secondary text-white">
              <i class="fas fa-list mr-2"></i>User Task Detail
            </div>
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-striped table-hover">
                  <thead class="thead-dark">
                    <tr>
                      <th>Subtask Id</th>
                      <th>Subtask Name</th>
                      <th>Subtask Description</th>
                      <th>Subtask Status</th>
                      <th>Document</th>
                      <th>Document Upload</th>
                      <th>Device Type</th>
                      <th>Device</th>
                      <th>Training Module</th>
                      <th>Handover</th>
                      <th>Survey/Interview</th>
                      <th>Start Date</th>
                      <th>End Date</th>
                      <th>Last Updated</th>
                      <th class="text-center">Action</th>
                    </tr>
                  </thead>
                  <tbody id="userTaskDetailList">
                    <tr>
                      <td colspan="15" class="text-center">
                        Click a task header to view details.
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Footer -->
    <%- include('../partials/footer-simple') %>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Custom JS -->
    <script src="/js/report-user-task.js" type="module"></script>
  </body>
</html>
<style>
  body {
    font-family: Arial, sans-serif;
    background-color: #f8f9fa;
  }

  .container-fluid {
    padding: 15px;
  }

  /* Card styling */
  .card {
    border: none;
    margin-bottom: 1.5rem;
    border-radius: 0.5rem;
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
  }

  .card-header {
    font-weight: bold;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.125);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .card-body {
    padding: 1.25rem;
  }

  /* Table styling */
  .table thead th {
    background-color: #343a40;
    color: #fff;
    border-bottom: 2px solid #495057;
    font-size: 0.9rem;
  }

  .table tbody td {
    font-size: 0.85rem;
    vertical-align: middle;
  }

  .table-striped tbody tr:nth-of-type(odd) {
    background-color: rgba(0, 0, 0, 0.05);
  }

  .table-hover tbody tr:hover {
    background-color: rgba(0, 0, 0, 0.075);
  }

  .table-responsive {
    overflow-y: auto;
    max-height: 600px; /* Adjust the value as needed */
  }

  /* Sticky header styling */
  .table thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    background-color: #343a40; /* Bootstrap dark color */
    color: white;
  }

  /* Button styling */
  .btn-primary {
    background-color: #007bff;
    border-color: #007bff;
  }

  .btn-primary:hover {
    background-color: #0069d9;
    border-color: #0062cc;
  }
</style>
