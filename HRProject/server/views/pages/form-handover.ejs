<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Handover Form</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <link
      href="https://cdn.quilljs.com/1.3.6/quill.snow.css"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- Navbar -->
    <%- include('../partials/navbar') %>

    <div class="container my-5">
      <div class="survey-container">
        <h2 id="form-title" class="text-center mb-4">Handover Form</h2>
        <form id="handoverForm">
          <div class="form-group">
            <label for="handoverPerson">Handover Person</label>
            <select class="form-control" id="handoverPerson" required>
              <option value="" disabled selected>Select a Person</option>
            </select>
          </div>
          <div class="form-group">
            <label for="handoverNote">Handover Note</label>
            <div id="editor" style="height: 300px"></div>
          </div>
          <button type="submit" id="btn-save" class="btn btn-primary">
            Submit
          </button>
        </form>
      </div>
    </div>

    <!-- Footer -->
    <%- include('../partials/footer-simple') %>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
     
    <script src="/js/form-handover.js" type="module"></script>
  </body>
</html>
<style>
  .parent {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    padding: 20px;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    background: white;
  }
  .table-container {
    max-height: 600px;
    overflow-y: auto;
    border-radius: 10px;
  }
  thead th {
    position: sticky;
    top: 0;
    background: #000000 !important;
    color: white !important;
    z-index: 10;
  }
  tbody tr:hover {
    background-color: #f1f1f1;
  }
  .survey-container {
    max-width: 600px;
    margin: auto;
    background: white;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
  }
  .form-group {
    margin-bottom: 15px;
  }
</style>
