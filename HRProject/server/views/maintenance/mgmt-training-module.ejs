<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Training Module Management</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <!-- Bootstrap 4 Toggle CSS (Choose this one) -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap4-toggle@3.6.1/css/bootstrap4-toggle.min.css"
      rel="stylesheet"
    />
    <!-- Remove Bootstrap Switch Button CSS -->
    <!-- <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-switch-button/css/bootstrap-switch-button.min.css" /> -->

    <style>
      /* Sticky header using Bootstrap's dark theme */
      .table thead.thead-dark th {
        position: sticky;
        top: 0;
        z-index: 10;
        /* Background/color handled by thead-dark */
      }

      /* Container for fixed height scrolling table */
      .table-container {
        max-height: 600px; /* Adjust as needed */
        overflow-y: auto;
      }

      /* Ensure toggles align nicely in table cells */
      .table td .toggle {
        margin-bottom: 0; /* Remove default bottom margin */
        vertical-align: middle;
      }

      /* Adjust alignment for controls row */
      .controls-row > .col-md-3:last-child {
        align-self: flex-end; /* Align button to bottom */
        margin-bottom: 1rem; /* Add space below button if needed */
      }
    </style>
  </head>

  <body>
    <!-- Navbar -->
    <%- include('../partials/navbar') %>

    <div class="container-fluid mt-4">
      <h2 class="text-center mb-4">Training Module Management</h2>

      <!-- Search Criteria Card -->
      <div class="card shadow-sm mb-4">
        <div class="card-header">
          <h5 class="mb-0">
            <i class="fas fa-search mr-2"></i>Search Criteria
          </h5>
        </div>
        <div class="card-body">
          <form id="search-form">
            <div class="form-row align-items-end">
              <div class="col-md-3 mb-2">
                <label for="searchName">Training Name</label>
                <input
                  type="text"
                  id="searchName"
                  class="form-control form-control-sm"
                  placeholder="Enter name..."
                />
              </div>
              <div class="col-md-3 mb-2">
                <label for="searchDepartment">Department</label>
                <select
                  id="searchDepartment"
                  class="form-control form-control-sm custom-select"
                >
                  <option value="" selected>All Departments</option>
                  <!-- Populate via JS -->
                </select>
              </div>
              <div class="col-md-2 mb-2">
                <label for="searchEnabled">Enabled</label>
                <select
                  id="searchEnabled"
                  class="form-control form-control-sm custom-select"
                >
                  <option value="" selected>All</option>
                  <option value="true">Yes</option>
                  <!-- Use true/false -->
                  <option value="false">No</option>
                </select>
              </div>
              <div class="col-md-2 mb-2">
                <button
                  type="submit"
                  class="btn btn-secondary btn-sm btn-block"
                  id="btnSearch"
                >
                  <i class="fas fa-search"></i> Search
                </button>
              </div>
              <div class="col-md-2 mb-2">
                <button
                  type="button"
                  class="btn btn-dark btn-sm btn-block"
                  id="btnAdd"
                  data-toggle="modal"
                  data-target="#trainingModuleModal"
                >
                  <i class="fas fa-plus"></i> Add New
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Training Modules List Card -->
      <div class="card shadow-sm">
        <div class="card-header">
          <h5 class="mb-0">
            <i class="fas fa-list-ul mr-2"></i>Training Modules
          </h5>
        </div>
        <div class="card-body p-0">
          <!-- Remove padding for edge-to-edge table -->
          <div class="table-responsive table-container">
            <table class="table table-striped table-hover mb-0">
              <thead class="thead-dark">
                <tr>
                  <th>Name</th>
                  <th>Description</th>
                  <th>Group/Department</th>
                  <th class="text-center">Enabled</th>
                  <th class="text-center">Actions</th>
                </tr>
              </thead>
              <tbody id="trainingTableBody"></tbody>
            </table>
          </div>
        </div>
        <div class="card-footer text-muted" id="tableFooter">
          Loading modules...
        </div>
      </div>
    </div>
    <!-- End Container -->

    <!-- Footer -->
    <%- include('../partials/footer-simple') %>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <!-- Bootstrap Switch Button (Required for toggle switches) -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap4-toggle@3.6.1/css/bootstrap4-toggle.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap4-toggle@3.6.1/js/bootstrap4-toggle.min.js"></script>
    <!-- Bootstrap Switch Button (Required for toggle switches) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-switch-button/js/bootstrap-switch-button.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/mgmt-training-module.js" type="module"></script>
  </body>
</html>
