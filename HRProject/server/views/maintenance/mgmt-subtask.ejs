<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Subtask Management</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />

    <style>
      /* Sticky header using Bootstrap's dark theme */
      .table thead.thead-dark th {
        position: sticky;
        top: 0;
        z-index: 10;
        background-color: #343a40; /* Explicit dark background */
        color: white;
        vertical-align: middle;
      }

      /* Table container scroll */
      .table-container {
        max-height: 600px; /* Adjust height */
        overflow-y: auto;
        position: relative; /* Needed for sticky header */
      }

      /* Center content in specific columns */
      .table th.text-center,
      .table td.text-center {
        text-align: center;
        vertical-align: middle;
      }

      /* Modal styling */
      .modal-content {
        border-radius: 8px;
      }
      .modal-header .close {
        padding: 1rem;
        margin: -1rem -1rem -1rem auto;
        font-size: 1.5rem;
      }

      /* Header styling */
      #taskNameDisplay {
        color: #495057; /* Bootstrap default text color */
        font-weight: 600;
      }
      .page-header {
        border-bottom: 1px solid #dee2e6;
        padding-bottom: 1rem;
      }
    </style>
  </head>

  <body>
    <!-- Navbar -->
    <%- include('../partials/navbar') %>

    <!-- Content -->
    <div class="container-fluid mt-4">
      <!-- Page Header -->
      <div
        class="d-flex justify-content-between align-items-center mb-4 page-header"
      >
        <h2 class="mb-0">
          Subtasks for: <span id="taskNameDisplay">(Loading...)</span>
        </h2>
        <!-- Hidden input to store parent task ID -->
        <input type="hidden" id="parentTaskId" />

        <div class="btn-group" role="group">
          <button
            type="button"
            class="btn btn-dark btn-sm"
            id="addSubtaskButton"
            data-toggle="modal"
            data-target="#subtaskModal"
          >
            <i class="fas fa-plus mr-1"></i> Add Subtask
          </button>
          <a
            href="/mgmt-task"
            class="btn btn-secondary btn-sm"
            id="backToTaskBtn"
          >
            <i class="fas fa-arrow-left mr-1"></i> Back to Tasks
          </a>
        </div>
      </div>

      <!-- Subtask List Card -->
      <div class="card shadow-sm">
        <div class="card-header">
          <h5 class="mb-0"><i class="fas fa-list-ol mr-2"></i>Subtask List</h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive table-container">
            <table class="table table-hover mb-0" id="subtaskTable">
              <thead class="thead-dark">
                <tr>
                  <th>ID</th>
                  <th>Subtask Name</th>
                  <th>Description</th>
                  <th>Document</th>
                  <th class="text-center">Upload Req.</th>
                  <th>Device Type</th>
                  <th>Training</th>
                  <th class="text-center">Handover</th>
                  <th>Survey</th>
                  <th class="text-center">Enabled</th>
                  <th class="text-center">Actions</th>
                </tr>
              </thead>
              <tbody id="subtaskTableBody">
                <!-- Data populated by JS -->
                <tr>
                  <td colspan="11" class="text-center text-muted">
                    Loading subtasks...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
        <div class="card-footer text-muted" id="tableFooter">Loading...</div>
      </div>
    </div>
    <!-- End Container -->

    <!-- Add/Edit Subtask Modal -->
    <div
      class="modal fade"
      id="subtaskModal"
      tabindex="-1"
      aria-labelledby="subtaskModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-lg" role="document">
        <!-- modal-lg for more space -->
        <div class="modal-content shadow">
          <div class="modal-header">
            <h5 class="modal-title" id="subtaskModalLabel">Add Subtask</h5>
            <!-- Correct BS4 close button -->
            <button
              type="button"
              class="close"
              data-dismiss="modal"
              aria-label="Close"
            >
              <span aria-hidden="true">×</span>
            </button>
          </div>
          <div class="modal-body">
            <form id="subtaskForm">
              <!-- Hidden Subtask ID for edits -->
              <input type="hidden" id="subtaskId" />

              <!-- Subtask Name -->
              <div class="form-group">
                <label for="subtaskName"
                  >Subtask Name <span class="text-danger">*</span></label
                >
                <input
                  type="text"
                  class="form-control"
                  id="subtaskName"
                  required
                />
              </div>

              <!-- Description -->
              <div class="form-group">
                <label for="subtaskDescription">Description</label>
                <textarea
                  class="form-control"
                  id="subtaskDescription"
                  rows="3"
                ></textarea>
              </div>

              <!-- Row for related items -->
              <div class="form-row">
                <div class="col-md-6 form-group">
                  <label for="documentId">Document Template</label>
                  <select class="form-control custom-select" id="documentId">
                    <option value="">None</option>
                    <!-- Allow None, value="" -->
                    <!-- Options populated by JS -->
                  </select>
                </div>
                <div class="col-md-6 form-group">
                  <label for="fileRequirement">Document Upload Required?</label>
                  <select
                    class="form-control custom-select"
                    id="fileRequirement"
                  >
                    <option value="false">No</option>
                    <!-- Use boolean strings -->
                    <option value="true">Yes</option>
                  </select>
                  <small class="form-text text-muted"
                    >User must upload a file for this step?</small
                  >
                </div>
              </div>

              <div class="form-row">
                <div class="col-md-6 form-group">
                  <label for="deviceId">Device Type</label>
                  <select class="form-control custom-select" id="deviceId">
                    <option value="">None</option>
                    <!-- Options populated by JS -->
                  </select>
                </div>
                <div class="col-md-6 form-group">
                  <label for="trainingModuleId">Training Module</label>
                  <select
                    class="form-control custom-select"
                    id="trainingModuleId"
                  >
                    <option value="">None</option>
                    <!-- Options populated by JS -->
                  </select>
                </div>
              </div>

              <div class="form-row">
                <div class="col-md-6 form-group">
                  <label for="surveyId">Survey / Interview</label>
                  <select class="form-control custom-select" id="surveyId">
                    <option value="">None</option>
                    <!-- Options populated by JS -->
                  </select>
                </div>
                <div class="col-md-6 form-group">
                  <label for="handoverId">Handover Required?</label>
                  <select class="form-control custom-select" id="handoverId">
                    <option value="false">No</option>
                    <!-- Use boolean strings -->
                    <option value="true">Yes</option>
                  </select>
                </div>
              </div>

              <div class="form-row">
                <div class="col-md-6 form-group">
                  <label for="enabled">Enable Subtask?</label>
                  <select class="form-control custom-select" id="enabled">
                    <option value="true">Yes</option>
                    <!-- Use boolean strings -->
                    <option value="false" selected>No</option>
                    <!-- Default to No -->
                  </select>
                </div>
                <!-- Optional: Add Order/Sequence field if needed -->
              </div>
            </form>
            <!-- End Form Tag -->
          </div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-secondary"
              data-dismiss="modal"
            >
              Close
            </button>
            <!-- Link button to form for submission -->
            <button
              type="submit"
              class="btn btn-dark"
              id="saveSubtaskBtn"
              form="subtaskForm"
            >
              Save Subtask
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <%- include('../partials/footer-simple') %>

    <!-- JS -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script type="module" src="/js/mgmt-subtask.js"></script>
  </body>
</html>
