<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Access Management</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />

    <style>
      /* Sticky header using Bootstrap's dark theme */
      .table thead.thead-dark th {
        position: sticky;
        top: 0;
        z-index: 10;
        background-color: #343a40; /* Explicit dark background */
        color: white;
        vertical-align: middle;
      }

      /* Table container scroll */
      .table-container {
        max-height: 280px; /* Adjust height for split view */
        overflow-y: auto;
        position: relative; /* Needed for sticky header */
      }
      .user-table-container {
        max-height: 600px; /* User list can be taller */
        overflow-y: auto;
        position: relative;
      }

      /* Row highlighting */
      #userTableBody tr.table-active {
        background-color: #cfe2ff !important; /* Ensure highlight overrides hover */
        font-weight: bold;
      }
      #userTableBody tr:hover {
        cursor: pointer;
      }

      /* Checkbox styling */
      .select-checkbox {
        width: 1.1rem;
        height: 1.1rem;
        cursor: pointer;
        accent-color: #007bff;
        vertical-align: middle;
      }
      .select-checkbox:hover {
        opacity: 0.8;
      }
      .table th.checkbox-col,
      .table td.checkbox-col {
        width: 5%;
        text-align: center;
      }

      /* Ensure filter controls are compact */
      #availableAccessFilterForm .form-control-sm {
        margin-bottom: 0.5rem;
      }
      #availableAccessFilterForm label {
        margin-bottom: 0.2rem;
        font-size: 0.85rem;
      }

      /* Add space between the two cards in the right column */
      #assignedAccessCard {
        margin-bottom: 1.5rem;
      }
    </style>
  </head>

  <body>
    <!-- Navbar -->
    <%- include('../partials/navbar') %>

    <div class="container-fluid mt-4">
      <h2 class="text-center mb-4">User Access Management</h2>

      <div class="row">
        <!-- Left Column: User List -->
        <div class="col-lg-4 mb-4 mb-lg-0">
          <div class="card shadow-sm">
            <div class="card-header">
              <h5 class="mb-0"><i class="fas fa-users mr-2"></i>Users</h5>
            </div>
            <div class="card-body">
              <div class="input-group input-group-sm mb-3">
                <input
                  type="text"
                  id="searchUser"
                  class="form-control"
                  placeholder="Search username or role..."
                  aria-label="Search Users"
                />
                <div class="input-group-append">
                  <button
                    class="btn btn-outline-secondary"
                    type="button"
                    id="searchUserBtn"
                  >
                    <i class="fas fa-search"></i>
                  </button>
                </div>
              </div>
              <div class="user-table-container">
                <table class="table table-hover">
                  <!-- Removed table-striped for better active highlight visibility -->
                  <thead class="thead-dark">
                    <tr>
                      <th>User ID</th>
                      <th>Username</th>
                      <th>Role</th>
                    </tr>
                  </thead>
                  <tbody id="userTableBody"></tbody>
                </table>
              </div>
            </div>
            <div class="card-footer text-muted" id="userListFooter">
              Select a user to manage their access.
            </div>
          </div>
        </div>
        <!-- End Left Column -->

        <!-- Right Column: Assigned & Available Access -->
        <div class="col-lg-8">
          <!-- Assigned Access Card -->
          <div class="card shadow-sm" id="assignedAccessCard">
            <div
              class="card-header d-flex justify-content-between align-items-center"
            >
              <h5 class="mb-0">
                <i class="fas fa-user-check mr-2"></i>Assigned Access for:
                <strong id="assignedUserName">(Select User)</strong>
              </h5>
              <button
                id="removeSelectedAccessBtn"
                class="btn btn-danger btn-sm"
                disabled
              >
                <i class="fas fa-minus-circle mr-1"></i> Remove Selected
              </button>
            </div>
            <div class="card-body p-0">
              <div class="table-container">
                <table class="table table-hover mb-0">
                  <!-- Removed striped -->
                  <thead class="thead-dark">
                    <tr>
                      <th class="checkbox-col">
                        <input
                          type="checkbox"
                          class="select-checkbox"
                          id="selectAllAssigned"
                          title="Select/Deselect All Assigned"
                        />
                      </th>
                      <th>Access Name</th>
                      <th>Access Type</th>
                    </tr>
                  </thead>
                  <tbody id="assignedAccessTableBody">
                    <!-- Populated by JS based on selected user -->
                    <tr>
                      <td colspan="3" class="text-center text-muted">
                        Select a user to view assigned access.
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
            <div class="card-footer text-muted d-flex justify-content-between">
              <span>Assigned Count: <strong id="assignedCount">0</strong></span>
              <span
                >Selected: <strong id="assignedSelectedCount">0</strong></span
              >
            </div>
          </div>
          <!-- End Assigned Access Card -->

          <!-- Available Access Card -->
          <div class="card shadow-sm" id="availableAccessCard">
            <div
              class="card-header d-flex justify-content-between align-items-center"
            >
              <h5 class="mb-0">
                <i class="fas fa-list-ul mr-2"></i>Available Accesses (for
                <strong id="availableForUserName">(Select User)</strong>)
              </h5>
              <button
                id="addSelectedAccessBtn"
                class="btn btn-success btn-sm"
                disabled
              >
                <i class="fas fa-plus-circle mr-1"></i> Add Selected to User
              </button>
            </div>
            <div class="card-body pb-0">
              <!-- Remove bottom padding -->
              <!-- Filter Form -->
              <form id="availableAccessFilterForm" class="mb-2">
                <div class="form-row">
                  <div class="col-md-5">
                    <label for="filterAccessName">Filter by Name</label>
                    <input
                      type="text"
                      id="filterAccessName"
                      class="form-control form-control-sm"
                      placeholder="Enter access name..."
                    />
                  </div>
                  <div class="col-md-4">
                    <label for="filterAccessType">Filter by Type</label>
                    <select
                      id="filterAccessType"
                      class="form-control form-control-sm custom-select"
                    >
                      <option value="" selected>All Types</option>
                      <!-- Populate via JS -->
                    </select>
                  </div>
                  <div class="col-md-3 d-flex align-items-end">
                    <button
                      type="submit"
                      class="btn btn-secondary btn-sm btn-block"
                    >
                      Filter
                    </button>
                  </div>
                </div>
              </form>

              <div class="table-container">
                <table class="table table-hover mb-0">
                  <!-- Removed striped -->
                  <thead class="thead-dark">
                    <tr>
                      <th class="checkbox-col">
                        <input
                          type="checkbox"
                          class="select-checkbox"
                          id="selectAllAvailable"
                          title="Select/Deselect All Available"
                        />
                      </th>
                      <th>Access Name</th>
                      <th>Access Type</th>
                      <th class="text-center">Enabled</th>
                    </tr>
                  </thead>
                  <tbody id="availableAccessTableBody">
                    <!-- Populated by JS based on selected user and filters -->
                    <tr>
                      <td colspan="4" class="text-center text-muted">
                        Select a user to view available access.
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
            <div class="card-footer text-muted d-flex justify-content-between">
              <span
                >Available Count: <strong id="availableCount">0</strong></span
              >
              <span
                >Selected: <strong id="availableSelectedCount">0</strong></span
              >
            </div>
          </div>
          <!-- End Available Access Card -->
        </div>
        <!-- End Right Column -->
      </div>
      <!-- End Main Row -->
    </div>
    <!-- End Container -->

    <!-- Footer -->
    <%- include('../partials/footer-simple') %>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/mgmt-user-access.js" type="module"></script>
  </body>
</html>
