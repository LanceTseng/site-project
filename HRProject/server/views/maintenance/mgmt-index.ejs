<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Maintenance Menu</title>

    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <style>
    body {
      background-color: #f8f9fa;
    }
    .card {
      transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
      border-radius: 12px;
      border: none;
    }
    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }
    .card i {
      font-size: 2rem;
      color: #007bff;
    }
    .custom-btn {
      background-color: #007bff;
      border: none;
      color: white;
      width: 100%;
      border-radius: 8px;
      transition: background 0.3s ease-in-out;
    }
    .custom-btn:hover {
      background-color: #0056b3;
    }
    .navbar, .footer {
      background-color: #343a40;
      color: white;
    }
  </style>
  <body>
    <%- include('../partials/navbar') %>

    <div class="container mt-5">
      <div class="row g-4">
        <div class="col-md-4">
          <div class="card p-4 text-center">
            <i class="fas fa-tasks"></i>
            <h5 class="card-title mt-3">Task Management</h5>
            <p class="card-text">Manage tasks for maintenance activities.</p>
            <a href="/mgmt-task" class="btn custom-btn">Go to Task</a>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card p-4 text-center">
            <i class="fas fa-tools"></i>
            <h5 class="card-title mt-3">Equipment</h5>
            <p class="card-text">View and manage maintenance equipment.</p>
            <a href="/mgmt-equiptment" class="btn custom-btn">Go to Equipment</a>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card p-4 text-center">
            <i class="fas fa-user-cog"></i>
            <h5 class="card-title mt-3">User/Employee</h5>
            <p class="card-text">Manage users and employees.</p>
            <a href="/mgmt-user-employee" class="btn custom-btn">Go to User</a>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card p-4 text-center">
            <i class="fas fa-file-alt"></i>
            <h5 class="card-title mt-3">Documents</h5>
            <p class="card-text">View and manage maintenance documents.</p>
            <a href="/mgmt-document" class="btn custom-btn">Go to Documents</a>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card p-4 text-center">
            <i class="fas fa-chalkboard-teacher"></i>
            <h5 class="card-title mt-3">Training</h5>
            <p class="card-text">Access and manage training modules.</p>
            <a href="#" class="btn custom-btn">Go to Training</a>
          </div>
        </div>
      </div>
    </div>

    <%- include('../partials/footer-simple') %>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.3/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

    <script src="/js/maintenance.js"></script>
  </body>
</html>
