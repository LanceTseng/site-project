@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Successful</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body {
            background-color: #f8f9fa;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .success-container {
            text-align: center;
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }
        .checkmark {
            font-size: 80px;
            color: #28a745;
        }
        .btn-home {
            margin-top: 20px;
            font-size: 18px;
            padding: 10px 20px;
        }
    </style>
</head>
<body>

<div class="success-container">
    <div class="checkmark">✔</div>
    <h2 class="text-success fw-bold">Payment Successful!</h2>
    <p class="text-muted">Thank you for your purchase.</p>
    <button class="btn btn-success btn-home" onclick="goToHome()">Go to Home</button>
</div>

<script>
        function goToHome() {
            window.location.href = "/home"; // Change to your home page URL
        }
    </script>

</body>
</html>