@{
    ViewData["Title"] = "Checkout";

}

<head>
    <!-- ✅ Styles First -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community/styles/ag-theme-quartz.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
     
</head>
<body>
    <div class="container-fluid py-5">
        <div class="row g-4">

            <!-- 🛍️ Product List -->
            <div class="col-md-4">
                <div class="card shadow-lg p-3">
                    <h4 class="fw-bold text-primary"><i class="fas fa-list"></i> Product List</h4>
                    <table class="table table-hover mt-3">
                        <thead class="table-primary">
                        <tr>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Qty</th>
                            <th>Total</th>
                            <th>Action</th>
                        </tr>
                        </thead>
                        <tbody id="product-list">
                            <!-- Dynamic Products Here -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 🛒 Cart Section -->
            <div class="col-md-4">
                <div class="card shadow-lg p-3">
                    <h4 class="fw-bold text-warning"><i class="fas fa-shopping-cart"></i> Your Cart</h4>
                    <table class="table table-hover mt-3">
                        <thead class="table-warning">
                        <tr>
                            <th>Product</th>
                            <th>Qty</th>
                            <th>Total</th>
                            <th>Action</th>
                        </tr>
                        </thead>
                        <tbody id="cart-items">
                            <!-- Dynamic Cart Items Here -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 🏁 Order Summary -->
            <div class="col-md-4">
                <div class="card shadow-lg p-3">
                    <h4 class="fw-bold text-success"><i class="fas fa-receipt"></i> Summary</h4>
                    <p class="fw-semibold">Items: <span id="item-count">0</span></p>
                    <p class="fw-semibold">Subtotal: <span id="subtotal">$0.00</span></p>

                    <hr>

                    <h5 class="text-dark"><i class="fas fa-credit-card"></i> Payment Info</h5>
                    <form>
                        <div class="mb-2">
                            <label class="form-label">Customer Name</label>
                            <input type="text" class="form-control rounded-pill" placeholder="Full Name" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Name on Credit Card</label>
                            <input type="text" class="form-control rounded-pill" placeholder="Card Name" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Credit Card Number</label>
                            <input type="text" class="form-control rounded-pill" placeholder="Card Number" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">CV Code</label>
                            <input type="text" class="form-control rounded-pill" placeholder="CV Code" />
                        </div>
                        <button type="submit" class="btn btn-success w-100 mt-3 rounded-pill fw-bold">
                            <i class="fas fa-check"></i> Place Order
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>

    <!-- Include Bootstrap & FontAwesome -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/ag-grid-community@31.0.1/dist/ag-grid-community.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/menu.js"></script>
</body>
<!-- JavaScript to Handle Cart & Summary Updates -->
