@{
    ViewData["Title"] = "Cart Records Management";
}

<head>
    <!-- ✅ Styles -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community/styles/ag-theme-quartz.css">
</head>

<body>
    <div class="container mt-4">
        <h2 class="mb-4 text-primary text-center">Cart Records Management</h2>

        <!-- 🔍 Search Filters -->
        <div class="card p-3 shadow-sm">
            <h5 class="mb-3 text-secondary">Search Filters</h5>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Transaction Code</label>
                    <input type="text" id="searchTransactionCode" class="form-control" placeholder="Enter transaction code">
                </div>
                <div class="col-md-3">
                    <label class="form-label">User Name</label>
                    <input type="text" id="searchUserName" class="form-control" placeholder="Enter User Name">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Product Name</label>
                    <input type="text" id="searchProductName" class="form-control" placeholder="Enter Product Name">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select id="searchStatus" class="form-select">
                        <option value="">All</option>
                        <option value="paid">Paid</option>
                        <option value="pending">Pending</option>
                    </select>
                </div>
            </div>
            <div class="text-end mt-3">
                <button class="btn btn-primary" onclick="searchGrid()">🔍 Search</button>
                <button class="btn btn-secondary" onclick="resetFilters()">🔄 Reset</button>
            </div>
        </div>

        <!-- 🔘 Action Buttons -->
        <div class="d-flex justify-content-between align-items-center mt-4">
            @* <button class="btn btn-success" onclick="openModal()">➕ Add Record </button> *@
            <div>
                <button class="btn btn-danger" onclick="deleteSelectedRecords()">🗑 Delete Selected</button>
                <button class="btn btn-warning text-dark" onclick="toggleSelectAll()">✔ Select All / Unselect All</button>
            </div>
        </div>

        <!-- 📊 AG Grid Table -->
        <div id="cartGrid" class="ag-theme-quartz mt-4" style="height: 500px; border-radius: 5px;"></div>
    </div>

    <!-- ✨ Cart Record Modal -->
    <div id="cartModal" class="modal fade" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content p-3 shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title">Cart Record Form</h5>
                    <button type="button" class="btn-close" onclick="closeModal()"></button>
                </div>
                <div class="modal-body">
                    <form id="cartForm">
                        <input type="hidden" id="cartId">

                        <div class="mb-3" hidden>
                            <label class="form-label">Product ID</label>
                            <input type="number" id="cartProductId" class="form-control">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Product Name</label>
                            <input type="text" id="cartProductName" class="form-control" disabled="">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Price</label>
                            <input type="number" id="cartProductPrice" class="form-control" step="0.01" disabled="">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Quantity</label>
                            <input type="number" id="cartQty" class="form-control" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Total</label>
                            <input type="number" id="cartTotal" class="form-control" step="0.01" disabled="">
                        </div>

                        <div class="mb-3" hidden>
                            <label class="form-label">User ID</label>
                            <input type="number" id="cartUserId" class="form-control">
                        </div>

                        <div class="mb-3" hidden>
                            <label class="form-label">Status</label>
                            <input type="text" id="cartStatus" class="form-control">
                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-primary">💾 Save</button>
                            <button type="button" class="btn btn-secondary" onclick="closeModal()">❌ Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- ✨ Order Detail Modal -->
    <div id="orderModal" class="modal fade" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content p-3 shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title">Order Details</h5>
                    <button type="button" class="btn-close" onclick="closeOrderModal()"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Transaction Code:</strong> <span id="orderTransactionCode"></span></p>
                    <p><strong>Subtotal:</strong> $<span id="orderSubtotal"></span></p>
                    <p><strong>Date:</strong> <span id="orderDate"></span></p>
                    <p><strong>User ID:</strong> <span id="orderUserId"></span></p>
                    <p><strong>Status:</strong> <span id="orderStatus"></span></p>
                </div>
            </div>
        </div>
    </div>

    <!-- ✅ Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/ag-grid-community@31.0.1/dist/ag-grid-community.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/cartRecord.js"></script>
</body>
