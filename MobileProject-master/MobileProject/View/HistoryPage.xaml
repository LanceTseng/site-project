<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MobileProject.View.HistoryPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="History">
    <ScrollView>
        <StackLayout>
            <!--  Header Section  -->
            <StackLayout Padding="10" Orientation="Vertical">
                <Label
                    FontAttributes="Bold"
                    FontSize="Medium"
                    HorizontalOptions="Center"
                    Text="Order History" />
                <Grid ColumnSpacing="10" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!--  Row 0  -->
                        <RowDefinition Height="Auto" />
                        <!--  Row 1  -->
                        <RowDefinition Height="Auto" />
                        <!--  Row 2  -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!--  Column 0  -->
                        <ColumnDefinition Width="*" />
                        <!--  Column 1  -->
                    </Grid.ColumnDefinitions>

                    <!--  Date From Picker  -->
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Date From:"
                        VerticalOptions="Center" />
                    <DatePicker
                        x:Name="DateFromSearchPicker"
                        Grid.Row="0"
                        Grid.Column="1"
                        Date="{Binding DateFrom, Mode=TwoWay}" />

                    <!--  Date To Picker  -->
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="Date To:"
                        VerticalOptions="Center" />
                    <DatePicker
                        x:Name="DateToSearchPicker"
                        Grid.Row="1"
                        Grid.Column="1"
                        Date="{Binding DateTo, Mode=TwoWay}" />

                    <!--  Transaction Code Entry  -->
                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        Text="Transaction Code:"
                        VerticalOptions="Center" />
                    <Entry
                        x:Name="TransactionCodeEntry"
                        Grid.Row="2"
                        Grid.Column="1"
                        Placeholder="Enter code"
                        Text="{Binding TransactionCode}" />
                </Grid>

                <!--  Query Button  -->
                <Button
                    Margin="0,10,0,0"
                    Command="{Binding SearchCommand}"
                    Text="Search" />
            </StackLayout>

            <!--  Divider  -->
            <BoxView
                Margin="10,5"
                BackgroundColor="Gray"
                HeightRequest="1" />

            <!--  ListView for Orders with Height Limit  -->
            <StackLayout>
                <ListView
                    x:Name="OrdersListView"
                    HeightRequest="200"
                    ItemsSource="{Binding Orders}"
                    RowHeight="60"
                    SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                    SeparatorVisibility="Default">
                    <!--  Header Section  -->
                    <ListView.Header>
                        <StackLayout Padding="0" BackgroundColor="SkyBlue">
                            <Grid Padding="10" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <!--  Header Labels  -->
                                <Label
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Start"
                                    Text="Date"
                                    TextColor="Black"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    Text="Transaction Code"
                                    TextColor="Black"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="2"
                                    FontAttributes="Bold"
                                    HorizontalOptions="End"
                                    Text="Subtotal"
                                    TextColor="Black"
                                    VerticalOptions="Center" />
                            </Grid>
                        </StackLayout>
                    </ListView.Header>

                    <!--  Item Template  -->
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Grid Padding="10" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Column="0"
                                        FontSize="Small"
                                        Text="{Binding Date, StringFormat='{0:yyyy-MM-dd}'}"
                                        TextColor="DarkBlue"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        FontSize="Small"
                                        HorizontalOptions="Center"
                                        Text="{Binding TransactionCode}"
                                        TextColor="DarkBlue"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="2"
                                        FontSize="Small"
                                        HorizontalOptions="Center"
                                        Text="{Binding Subtotal, StringFormat='${0:F2}'}"
                                        TextColor="DarkBlue"
                                        VerticalOptions="Center" />
                                </Grid>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackLayout>

            <!--  Divider  -->
            <BoxView
                Margin="10,5"
                BackgroundColor="Gray"
                HeightRequest="1" />

            <!--  Order Details Section  -->
            <StackLayout Padding="10">
                <Label
                    FontAttributes="Bold"
                    FontSize="Medium"
                    Text="Order Details" />

                <Grid ColumnSpacing="10" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <!--  Allow the CollectionView to expand  -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!--  Column Headers  -->
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        FontAttributes="Bold"
                        Text="Item Name" />
                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        FontAttributes="Bold"
                        Text="Qty" />
                    <Label
                        Grid.Row="0"
                        Grid.Column="2"
                        FontAttributes="Bold"
                        Text="Total" />

                    <!--  CollectionView for Items  -->
                    <CollectionView
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        ItemsSource="{Binding SelectedOrderDetails}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Text="{Binding Product.Name}" />
                                    <Label Grid.Column="1" Text="{Binding CartRecord.Qty}" />
                                    <Label Grid.Column="2" Text="{Binding CartRecord.Total, StringFormat='${0:F2}'}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>