<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MobileProject.View.LoginPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Login">

    <StackLayout HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
        <Frame
            Padding="0"
            BorderColor="Transparent"
            CornerRadius="100"
            HasShadow="False"
            HeightRequest="100"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="100">
            <Image
                Aspect="AspectFill"
                HeightRequest="100"
                Source="login.png"
                WidthRequest="100" />
        </Frame>

        <Entry
            Keyboard="Default"
            Placeholder="Username"
            Text="{Binding Username}" />
        <Entry
            IsPassword="True"
            Placeholder="Password"
            Text="{Binding Password}" />
        <Button
            Command="{Binding LoginCommand}"
            IsEnabled="{Binding LoginCommand}"
            Text="Login" />
        <!--<Button Clicked="btnLogin_Clicked" Text="Login" />-->
        <Label Text="Not a Member? Click the button and sign up now!" />
        <Button Command="{Binding NavigateToSignUpCommand}" Text="Sign up" />
    </StackLayout>
</ContentPage>