<Window x:Class="Assignment1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment1"
        mc:Ignorable="d"
        Title="MainWindow-4558302-YuFen Tseng" Height="500" Width="800">
    <Grid Background="#FF82CBEF" Loaded="Grid_Loaded">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="21*"/>
            <ColumnDefinition Width="48*"/>
            <ColumnDefinition Width="331*"/>
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="panelQuestion" Margin="40,38,248,340" Background="#FF5EA3DE" Grid.ColumnSpan="3"/>
        <StackPanel Margin="434,38,38,23"  Background="#FF5EA3DE" Grid.Column="2">
            <Label x:Name="lblScore" Content="Score: " FontSize="20" Foreground="Black"/>
            <Label x:Name="lblQuestionQty" Content="Comp. Qty: " FontSize="20"/>
            <DataGrid x:Name="dtMiniUserRespReport" Height="348" d:ItemsSource="{d:SampleData ItemCount=5}" ColumnWidth="SizeToCells"/>

        </StackPanel>
        <StackPanel x:Name="panelOption" Margin="40,154,364,112"  Background="#FF5EA3DE" Grid.ColumnSpan="3"/>
        <Button x:Name="btnSubmit" Content="Submit" HorizontalAlignment="Left" Margin="310,175,0,0" VerticalAlignment="Top" Height="40" Width="114" Click="btnSubmit_Click" FontSize="20" Grid.Column="2"/>
        <Button x:Name="btnPrevious" Content="&lt;" HorizontalAlignment="Center" Margin="0,254,0,0" VerticalAlignment="Top" Height="40" Width="44" FontSize="20" Tag="-" Click="btnQuestionSequence_Click" Grid.Column="2"/>
        <Button x:Name="btnNext" Content="&gt;" HorizontalAlignment="Left" Margin="382,254,0,0" VerticalAlignment="Top" Height="40" Width="42" RenderTransformOrigin="0.415,-0.113" FontSize="20" Tag="+" Click="btnQuestionSequence_Click" Grid.Column="2"/>
        <StackPanel x:Name="panelMessage" Margin="40,388,364,23" Background="#FF5EA3DE" Grid.ColumnSpan="3">
            <Label x:Name="txtMsg" Content="" FontSize="25" Height="68"/>
        </StackPanel>
        <Button x:Name="btnEndTest" Content="End Test" HorizontalAlignment="Left" Margin="310,332,0,0" VerticalAlignment="Top" Height="40" Width="114" Click="btnEndTest_Click" FontSize="20" Grid.Column="2"/>
        <Button x:Name="btnReport" Content="Report" HorizontalAlignment="Left" Margin="310,396,0,0" VerticalAlignment="Top" Height="40" Width="114" Click="btnReport_Click" FontSize="20" Grid.Column="2"/>



    </Grid>
</Window>
