<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MobileProject.View.AdminMenu"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <ContentPage.Content>
        <StackLayout>
            <StackLayout Padding="10">
                <Label
                    FontAttributes="Bold"
                    FontSize="Large"
                    HorizontalOptions="Center"
                    Text="Admin Dashboard" />

                <!--  Menu List  -->
                <ListView
                    x:Name="MenuListView"
                    HasUnevenRows="True"
                    ItemTapped="OnMenuItemTapped"
                    ItemsSource="{Binding MenuItems}"
                    SeparatorVisibility="Default">
                    <ListView.Header>
                        <Label
                            Padding="5"
                            FontAttributes="Bold"
                            Text="Select an Option:" />
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextCell Detail="{Binding Description}" Text="{Binding Name}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackLayout>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>