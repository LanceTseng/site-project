<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MobileProject.View.AdminView.TableCrudPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <ContentPage.Content>
        <StackLayout Padding="10">
            <!--  Input Fields and Query Button  -->
            <StackLayout Margin="0,0,0,10" Orientation="Horizontal">
                <Entry
                    x:Name="ConditionEntry"
                    HorizontalOptions="FillAndExpand"
                    Placeholder="Enter condition" />
                <Button Command="{Binding QueryCommand}" Text="Query" />
            </StackLayout>

            <!--  Data List with Checkbox  -->
            <CollectionView ItemsSource="{Binding TableData}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="5" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding DisplayText}"
                                VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!--  Bulk Delete Button  -->
            <Button
                Margin="0,10,0,0"
                Command="{Binding DeleteCommand}"
                Text="Delete Selected" />
        </StackLayout>
    </ContentPage.Content>
    <ContentPage.ToolbarItems>
        <ToolbarItem
            Name="Add"
            Activated="OnAddClick"
            Order="Secondary"
            Priority="0" />
        <ToolbarItem
            Name="Remove"
            Activated="OnRemoveClick"
            Order="Secondary"
            Priority="1" />
        <ToolbarItem
            Name="Remove all"
            Activated="OnRemoveAllClick"
            Order="Secondary"
            Priority="2" />
        <ToolbarItem
            Name="Save"
            Activated="OnSaveClick"
            Order="Secondary"
            Priority="3" />
    </ContentPage.ToolbarItems>
</ContentPage>