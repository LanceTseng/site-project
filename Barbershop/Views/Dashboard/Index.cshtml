@{
    ViewData["Title"] = "Index";
    var role = ViewBag.UserRole;
    var userName = ViewBag.UserName;
}

<div class="container py-5">
    <div class="row text-center">
        <h2 class="mb-4">Dashboard</h2>
        <h3 class="mb-4">
            <div class="content">
                <div class="content__container">
                   @*  <p class="content__container__text">
                        Hello
                    </p> *@

                    <ul class="content__container__list">
                        <li class="content__container__list__item"> @userName</li>
                        <li class="content__container__list__item">@role</li>
                        <li class="content__container__list__item"> @userName (@role)</li>
                    </ul>
                </div>
            </div>
        </h3>

    </div>
    <div class="row g-4">
        <!-- Booking Card -->
        @if (role == "CUSTOMER" || role == "ADMIN")
        {
            <div class="col-lg-3 col-md-6">
                <div class="card shadow h-100 clickable-card" data-action="/appointment">
                    <div class="card-body d-flex flex-column align-items-center">
                        <i class="bi bi-calendar-check display-4 text-primary mb-3"></i>
                        <h5 class="card-title">Booking</h5>
                        <p class="card-text text-muted">Manage customer bookings easily.</p>
                    </div>
                </div>
            </div>
        }
        <div class="col-lg-3 col-md-6">
            <div class="card shadow h-100 clickable-card" data-action="/history">
                <div class="card-body d-flex flex-column align-items-center">
                    <i class="bi bi-people-fill display-4 text-success mb-3"></i>
                    <h5 class="card-title">History</h5>
                    <p class="card-text text-muted">Track and update appointments.</p>
                </div>
            </div>
        </div>

        @if (role == "EMPLOYEE" || role == "ADMIN")
        {
            <!-- Appointments Card -->
            <div class="col-lg-3 col-md-6">
                <div class="card shadow h-100 clickable-card" data-action="/appointment/approval">
                    <div class="card-body d-flex flex-column align-items-center">
                        <i class="bi bi-people-fill display-4 text-success mb-3"></i>
                        <h5 class="card-title">Appointments</h5>
                        <p class="card-text text-muted">Track and update appointments.</p>
                    </div>
                </div>
            </div>
            <!-- Check Out Card -->
            <div class="col-lg-3 col-md-6">
                <div class="card shadow h-100 clickable-card" data-action="/payment">
                    <div class="card-body d-flex flex-column align-items-center">
                        <i class="bi bi-cart-check display-4 text-warning mb-3"></i>
                        <h5 class="card-title">Check Out</h5>
                        <p class="card-text text-muted">Finalize payments and receipts.</p>
                    </div>
                </div>
            </div>
            <!-- Report Card -->
            @* <div class="col-lg-3 col-md-6">
        <div class="card shadow h-100 clickable-card" data-action="/Reports">
        <div class="card-body d-flex flex-column align-items-center">
        <i class="bi bi-bar-chart-line display-4 text-danger mb-3"></i>
        <h5 class="card-title">Report</h5>
        <p class="card-text text-muted">Analyze business performance.</p>
        </div>
        </div>
        </div> *@
        }
        @if (role == "ADMIN")
        {
            <!-- Admin Card -->
            <div class="col-lg-3 col-md-6">
                <div class="card shadow h-100 clickable-card" data-action="/admin">
                    <div class="card-body d-flex flex-column align-items-center">
                        <i class="bi bi-bar-chart-line display-4 text-danger mb-3"></i>
                        <h5 class="card-title">Admin</h5>
                        <p class="card-text text-muted">Administrator maintenance.</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Add click event to navigate to the respective sections
        document.querySelectorAll('.clickable-card').forEach(card => {
            card.addEventListener('click', function () {
                window.location.href = this.getAttribute('data-action');
            });
        });
    </script>
}



@* CSS Style*@
<style>
    .clickable-card {
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .clickable-card:hover {
            transform: scale(1.05);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
            background-color: lemonchiffon
        }
</style>
<link href="https://fonts.googleapis.com/css?family=Lato" rel="stylesheet">
<style>
    .content {
        position: relative;
        height: 40px; /* Matches the line height of one item */
        overflow: hidden;
        font-family: 'Lato', sans-serif;
        font-size: 35px;
        line-height: 40px;
        color: #000000;
        text-align: center;
    }

    .content__container {
        font-weight: 600;
        display: inline-block;
        position: relative;
        white-space: nowrap;
        padding: 0 20px; /* Space inside the brackets */
    }

    .content__container:before,
    .content__container:after {
        content: '';
        position: absolute;
        top: 0;
        font-size: 35px;
        color: #16a085;
    }

    .content__container:before {
        content: '[';
        left: -20px;
    }

    .content__container:after {
        content: ']';
        right: -20px;
    }

    .content__container__list {
        display: inline-block;
        margin: 0;
        padding: 0;
        list-style: none;
        animation: change 6s infinite;
    }

    .content__container__list__item {
        display: block;
        height: 40px;
        line-height: 40px;
        margin: 0;
    }

    /* Keyframes for animation */
    @@keyframes change {
        0% {
            transform: translateY(0);
        }
        25% {
            transform: translateY(-40px);
        }
        50% {
            transform: translateY(-80px);
        }
        75% {
            transform: translateY(-120px);
        }
        100% {
            transform: translateY(0);
        }
    }
</style>