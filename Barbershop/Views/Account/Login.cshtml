@model UserLoginModel;
@{
    ViewData["Title"] = "Login";
}


<body>
    <div class="container mt-5 container-login">
        <h1>Login</h1>
        <form asp-action="Login" method="post">
            <div class="form-group">
                <label asp-for="Username"></label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Login</button>
        </form>

        <!-- Register button (redirects to the Register view) -->
        <a asp-controller="Account" asp-action="Register" class="btn btn-success">Register</a>
    </div>
</body>
<style>
    body {
        font-family: Futura;
        background-color: #bbdaf4;
        display: block;
        justify-content: center;
        align-items: center;
    }

    .container-login {
        width: 100%;
        max-width: 405px;
        background: #f5f7f8;
        border-radius: 10px;
        padding: 30px;
    }

        .container-login h1 {
            text-align: center;
            font-size: 35px;
            margin-bottom: 25px;
            color: #0056b3;
            font-family: Futura, sans-serif;
            font-weight: bold;
        }

        .container-login label {
        font-size: 20px;
        color: #0056b3;
        font-family: Futura, sans-serif;
        font-weight: bold;
        padding: 3px;
    }

    .container-login .btn {
        display: block;
        width: 100%;
        height: 60px;
        padding: 5px;
        font-size: 22px;
        color: #fff;
        border-radius: 8px;
        margin-top: 10px;
        transition: background-color 0.7s;
    }

    .container-login .btn-primary {
        background-color: #22374d;
    }

            .container-login .btn-primary:hover {
            background-color: #0056b3;
        }

        .container-login .btn-success {
        background-color: #22374d;
        text-decoration: none;
        text-align: center;
        display: block;
    }

            .container-login .btn-success:hover {
            background-color: #218838;
        }

   
</style>