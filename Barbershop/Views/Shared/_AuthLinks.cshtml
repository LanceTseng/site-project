    For more information on enabling MVC for empty projects, visit http://go.microsoft.com/fwlink/?LinkID=397860

*@
@{
    if (!User.Identity.IsAuthenticated)
    {
        <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
    }
    else
    {
        <a href="javascript:void(0);" class="nav-link text-dark" onclick="submitLogoutForm(event)">Logout</a>
        <form id="logoutForm" asp-action="Logout" asp-controller="Account" method="post" style="display: none;"></form>
    }
}

<script>
    function submitLogoutForm(event) {
        event.preventDefault();  // Prevent any default behavior (like form submission)
        document.getElementById('logoutForm').submit();  // Manually submit the logout form
    }
</script>
