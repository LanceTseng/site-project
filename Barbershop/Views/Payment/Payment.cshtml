@model PaymentViewModel
@{
    ViewData["Title"] = "Payment";
}

<h1>Payment</h1>

<div class="container-fluid">
    <div class="row">

        <!-- Left Side: Schedule List -->
        <div class="col-md-3 border-end">
            <h5>Schedule List</h5>
            <div style="height: 700px; overflow-y: auto; border: 1px solid #ccc; padding: 10px; border-radius: 5px;">
                <ul class="list-group" id="scheduleList">
                    @foreach (var schedule in Model.Schedules)
                    {
                        <li class="list-group-item">
                            <input type="radio" name="selectedSchedule" value="@schedule.ScheduleId" class="schedule-radio" />
                            S# @schedule.ScheduleId - @schedule.Status
                            <div class="card">
                                <div class="card-body">
                                    <p><strong>Customer:</strong> @schedule.Customer.Username</p>
                                    <p><strong>Barber:</strong> @schedule.Barber.Username</p>
                                    <p><strong>Date:</strong> @schedule.StartTime.ToString("yyyy-MM-dd")</p>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
        <!-- Middle Section: Services -->
        <div class="col-md-5 border-end">
            <h5>Services</h5>
            <ul class="list-group" id="serviceList">
                <!-- Dynamically updated based on selected schedule -->
                <li class="list-group-item text-muted">Select a schedule to view services.</li>
            </ul>
            <ul class="list-group">
                <div class="card">
                    <div class=" card-body text-end" id="paymentList">
                        <p><strong>Total:</strong> <span class="badge text-light bg-dark rounded-pill">0.00</span></p>
                        <p><strong>Tax:</strong> <span class="badge text-light bg-dark rounded-pill">0.00</span></p>
                        <p><strong>SubTotal:</strong> <span class="badge text-light bg-dark rounded-pill">0.00</span></p>
                    </div>
                </div>
            </ul>
        </div>

        <!-- Right Side: Payment Options -->
        <div class="col-md-4">
            <h5>Payment Method</h5>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="paymentMethod" id="cashOption" value="Cash" checked />
                <label class="form-check-label" for="cashOption">Cash</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="paymentMethod" id="creditCardOption" value="CreditCard" />
                <label class="form-check-label" for="creditCardOption">Credit Card</label>
            </div>

            <!-- Cash Payment Details -->
            <div id="cashPayment" class="mt-3">
                <div class="form-group mb-3">
                    <label for="paidInput">Paid Amount</label>
                    <input type="number" id="paidInput" class="form-control" placeholder="Enter amount paid" />
                </div>

            </div>

            <!-- Credit Card Payment Details -->
            <div id="creditCardPayment" class="mt-3" style="display: none;">
                <div class="form-group mb-3">
                    <label for="cardNumber">Card Number</label>
                    <input type="text" id="cardNumber" class="form-control" placeholder="Enter card number" />
                </div>
                <div class="form-group mb-3">
                    <label for="cardCSV">CSV</label>
                    <input type="text" id="cardCSV" class="form-control" placeholder="Enter CSV" />
                </div>
                <div class="form-group mb-3">
                    <label for="cardExpiry">Expiry Date</label>
                    <input type="month" id="cardExpiry" class="form-control" />
                </div>
                <div class="form-group mb-3">
                    <label for="cardName">Cardholder Name</label>
                    <input type="text" id="cardName" class="form-control" placeholder="Enter cardholder name" />
                </div>
            </div>
            <div>
                <div class="form-group mb-3">
                    <label for="tipOption">Tip</label>
                    <select id="tipOption" class="form-select">
                        <option value="0">None</option>
                        <option value="0.1">10%</option>
                        <option value="0.18">18%</option>
                        <option value="0.25">25%</option>
                        <option value="custom">Other</option>
                    </select>
                </div>
                <div class="form-group mb-3" id="customTipContainer" style="display: none;">
                    <label for="customTip">Custom Tip</label>
                    <input type="number" id="customTip" class="form-control" placeholder="Enter custom tip amount" />
                </div>
                <div class="form-group mb-3" id="percentTipContainer" style="display: none;">
                    <label for="customTip">Custom Tip</label>
                    <input type="number" id="percentTip" class="form-control" disabled="" />
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    // Fetch and update services for the selected schedule
    const updateServicesBySchedule = async (scheduleId) => {
        try {
            const response = await fetch(`/payment/GetServicesBySchedule?scheduleId=${scheduleId}`);

            if (!response.ok) {
                console.error('Failed to fetch services:', response.statusText);
                displayError('Error fetching services.');
                return;
            }

            const services = await response.json();
            renderServices(services);
        } catch (error) {
            console.error('An error occurred while updating the service list:', error);
            displayError('Error fetching services.');
        }
    };

    // Render services and payment details
    const renderServices = (services) => {
        const serviceList = document.getElementById('serviceList');
        const paymentList = document.getElementById('paymentList');

        if (!serviceList || !paymentList) {
            console.error('Service list or payment list element not found in the DOM.');
            return;
        }

        // Clear previous content
        serviceList.innerHTML = '';
        paymentList.innerHTML = '';

        if (Array.isArray(services) && services.length > 0) {
            let total = 0;

            // Populate service list
            services.forEach(service => {
                const listItem = document.createElement('li');
                listItem.className = 'list-group-item d-flex justify-content-between align-items-center';

                const price = service.price !== undefined && service.price !== null
                    ? service.price.toFixed(2)
                    : 'N/A';

                listItem.innerHTML = `
                            ${service.serviceName || 'Unknown Service'}
                            <span class="badge bg-primary rounded-pill">${price}</span>
                        `;

                total += service.price || 0;
                serviceList.appendChild(listItem);
            });

            // Calculate tax and subtotal
            const tax = (total * 0.13).toFixed(2);
            const subtotal = (total + parseFloat(tax)).toFixed(2);

            // Update payment details
            paymentList.innerHTML = `
                        <div class="card-body text-end">
                            <p><strong>Total:</strong> <span class="badge text-light bg-dark rounded-pill">${total.toFixed(2)}</span></p>
                            <p><strong>Tax:</strong> <span class="badge text-light bg-dark rounded-pill">${tax}</span></p>
                            <p><strong>SubTotal:</strong> <span class="badge text-light bg-dark rounded-pill">${subtotal}</span></p>
                        </div>
                    `;
        } else {
            serviceList.innerHTML = '<li class="list-group-item text-muted">No services available for this schedule.</li>';
        }
    };

    // Display error message
    const displayError = (message) => {
        const serviceList = document.getElementById('serviceList');
        if (serviceList) {
            serviceList.innerHTML = `<li class="list-group-item text-muted">${message}</li>`;
        }
    };

    // Initialize schedule change listeners
    const initializeScheduleListeners = () => {
        document.querySelectorAll('.schedule-radio').forEach(radio => {
            radio.addEventListener('change', () => {
                updateServicesBySchedule(radio.value);
            });
        });
    };

    // Toggle payment sections based on selected payment method
    const togglePaymentSections = () => {
        document.querySelectorAll('input[name="paymentMethod"]').forEach(radio => {
            radio.addEventListener('change', () => {
                const isCash = radio.id === 'cashOption';
                document.getElementById('cashPayment').style.display = isCash ? 'block' : 'none';
                document.getElementById('creditCardPayment').style.display = !isCash ? 'block' : 'none';
            });
        });
    };

    // Initialize all event listeners
    const initializeEventListeners = () => {
        initializeScheduleListeners();
        togglePaymentSections();
    };

    // Run initialization on page load
    document.addEventListener('DOMContentLoaded', initializeEventListeners);
</script>
<script>
    // Function to calculate and display the tip
    function calculateTip(tipOptionId, totalId, customTipContainerId, percentTipContainerId, percentTipId) {
        const tipOption = document.getElementById(tipOptionId);
        const customTipContainer = document.getElementById(customTipContainerId);
        const percentTipContainer = document.getElementById(percentTipContainerId);
        const percentTip = document.getElementById(percentTipId);
        const totalElement = document.querySelector(`#${totalId} .badge.text-light.bg-dark`);

        if (!totalElement) {
            console.error('Total element not found.');
            return;
        }

        const total = parseFloat(totalElement.textContent);

        if (isNaN(total)) {
            console.error('Invalid total value.');
            return;
        }

        if (tipOption.value === 'custom') {
            // Show custom tip input
            customTipContainer.style.display = 'block';
            percentTipContainer.style.display = 'none';
            percentTip.value = ''; // Clear the percentage tip value
        } else {
            // Calculate percentage tip
            customTipContainer.style.display = 'none';
            percentTipContainer.style.display = 'block';

            const percentage = parseFloat(tipOption.value);
            const calculatedTip = (percentage * total).toFixed(2);

            percentTip.value = calculatedTip; // Display the calculated tip
        }
    }

    // Attach event listeners for cash payment tip
    document.querySelector('#tipOption').addEventListener('change', function () {
        calculateTip('tipOption', 'paymentList', 'customTipContainer', 'percentTipContainer', 'percentTip');
    });


    // Recalculate the tip when total changes dynamically
    function updateTipOnTotalChange() {
        calculateTip('tipOption', 'paymentList', 'customTipContainer', 'percentTipContainer', 'percentTip');
    }

</script>