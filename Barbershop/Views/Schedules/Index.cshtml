@using System.Globalization
@model IEnumerable<Barbershop.Models.Schedule>

@{
    ViewData["Title"] = "Index";
}

<h1>Appointment</h1>

<p>
    <a asp-action="Create" class="bi bi-plus-square-fill fs-2"></a>
</p>
<table class="table table-striped">
    <thead class="bg-dark text-white">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Customer)
            </th>
            <th>
                Customer Name
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Barber)
            </th>
            <th>
                Barber Name
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Service)
            </th>
            <th>
                Service Name
            </th>
            <th>
                Date
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Customer.UserId
                </td>
                <td>
                    @item.Customer.Username
                </td>
                <td>
                    @item.Barber.UserId
                </td>
                <td>
                    @item.Barber.Username
                </td>
                <td>
                    @item.Service.ServiceId
                </td>
                <td>
                    @item.Service.ServiceName
                </td>
                <td>
                    @item.StartTime.ToString("yyyy/MM/dd", CultureInfo.InvariantCulture)
                </td>
                <td>
                    @item.StartTime.ToString("hh:mm:ss tt", CultureInfo.InvariantCulture)
                </td>
                <td>
                    @item.EndTime.ToString("hh:mm:ss tt", CultureInfo.InvariantCulture)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Status)
                </td>
                <td>
                        <a asp-action="Edit" asp-route-id="@item.ScheduleId" class="bi bi-pencil-square btn-primary"></a> |
                    <a asp-action="Details" asp-route-id="@item.ScheduleId" class="bi bi-file-earmark-text btn-success"></a> |
                        <a asp-action="Delete" asp-route-id="@item.ScheduleId" class="bi bi-trash btn-danger"></a>
                </td>
            </tr>
        }
    </tbody>
</table>
