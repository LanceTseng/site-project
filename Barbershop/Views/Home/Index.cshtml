@{
    ViewData["Title"] = "Home Page";
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

    <!-- Hero Section -->
    <section class="bg-dark text-light text-center py-5 hero-section">
        <div class="container">
            <h1 class="display-4">Welcome to BYMAR Hair salon</h1>
            <p class="lead">Professional barbers, quality haircuts, and a modern vibe just for you.</p>
            <a href="@Url.Action("Index", "Appointment")" class="btn btn-primary btn-lg">Book Your Appointment</a>
        </div>
    </section>

    <!-- About Section -->
    <section class="container my-5">
        <div class="row align-items-center">
            <div class="col-md-6">
                <img src="https://images.unsplash.com/photo-1678356164573-9a534fe43958?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTJ8fGJhcmJlcnNob3B8ZW58MHx8MHx8fDA%3D" class="img-fluid rounded" alt="Barber Shop">
            </div>
            <div class="col-md-6">
                <h2>About Us</h2>
                <p>At BYMAR Hair salon, we are passionate about delivering high-quality cuts and grooming services. Our team of skilled barbers ensures that you receive a style tailored to you in a relaxing and professional environment.</p>
                <a href="@Url.Action("Privacy", "Home")" class="btn btn-outline-dark">Learn More</a>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section class=" py-5">
        <div class="container text-center">
            <h2 class="mb-4">Our Services</h2>
            <div class="row">
                <div class="col-md-4">
                    <div class="card mb-4 shadow-sm">
                        <img src="https://images.unsplash.com/photo-1541533848490-bc8115cd6522?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTJ8fGZhZGUlMjBoYWlyY3V0fGVufDB8fDB8fHww" class="card-img-top" alt="Haircut">
                        <div class="card-body">
                            <h5 class="card-title">Classic Haircut</h5>
                            <p class="card-text">Precision cuts to give you a fresh, clean look.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card mb-4 shadow-sm">
                        <img src="https://media.istockphoto.com/id/872361244/photo/man-getting-his-beard-trimmed-with-electric-razor.webp?a=1&b=1&s=612x612&w=0&k=20&c=ZFGPZr_9hJwGPMe-J24YJpf69aCnrzV98FLyhejtgj8=" class="card-img-top" alt="Beard Trim">
                        <div class="card-body">
                            <h5 class="card-title">Beard Trim & Shave</h5>
                            <p class="card-text">Sharp lines and smooth shaves for your best look.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card mb-4 shadow-sm">
                        <img src="https://images.unsplash.com/photo-1511920593290-3cb2deb1ce1c?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Nnx8c3R5bGluZyUyMGFuZCUyMGdyb29taW5nfGVufDB8fDB8fHww" class="card-img-top" alt="Styling">
                        <div class="card-body">
                            <h5 class="card-title">Styling & Grooming</h5>
                            <p class="card-text">Finish your look with top-quality styling products.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Barbers Section -->
    <section class="container py-5">
        <h2 class="text-center mb-4">Meet Our Barbers</h2>
        <div class="row">
            <div class="col-md-4 text-center">
                <img src="https://media.istockphoto.com/id/2157532121/photo/cheerful-hair-stylist-in-barber-shop.webp?a=1&b=1&s=612x612&w=0&k=20&c=PYB0GzWRaMeBVlcWiSE9a6OOzIR8QzhsoTPBBULT1oc=" class="rounded-circle mb-3" width="180" height="160" alt="Barber 1">
                <h5>John Doe</h5>
                <p>Master Barber</p>
            </div>
            <div class="col-md-4 text-center">
                <img src="https://media.istockphoto.com/id/1783230082/photo/portrait-of-young-female-hairdresser-in-salon.webp?a=1&b=1&s=612x612&w=0&k=20&c=Hl1P91vndjLpmixPzla1q52Pv-MKAmIzxQT1Y-fywBg=" class="rounded-circle mb-3" width="160" height="160" alt="Barber 2">
                <h5>Jane Smith</h5>
                <p>Stylist & Grooming Expert</p>
            </div>
            <div class="col-md-4 text-center">
                <img src="https://media.istockphoto.com/id/1340452153/photo/portrait-of-a-barber.jpg?s=612x612&w=0&k=20&c=H569XF8o-WnvOggaxBFxkaHvVJ8JpR_uzxk1r4EwmF0=" class="rounded-circle mb-3" width="150" height="150" alt="Barber 3">
                <h5>Mike Johnson</h5>
                <p>Shave Specialist</p>
            </div>
        </div>
    </section>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<style>
    .hero-section {
        width: 100%;
        height: 110vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background-image: url('https://images.unsplash.com/photo-1596513058031-bc51c5cbe091?w=1000&auto=format&fit=crop&q=60&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Mnx8YmFyYmVyc2hvcHxlbnwwfHwwfHx8MA%3D%3D');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
        filter: brightness(0.8);
    }

        .hero-section h1 {
            font-size: 70px;
            margin-bottom: 0;
            color: azure;
            font-family: Parkinsans;
        }

        .hero-section p {
            margin-bottom: 40px;
            color: whitesmoke;
            font-family: Parkinsans;
            font-size: 25px;
        }

        .hero-section .btn {
            border: 3px solid rgb(81, 230, 160);
            margin: 12px;
            padding: 10px;
            border-radius: 20px;
            color: antiquewhite;
            text-decoration: none;
        }

    body {
        background-color: #bbdaf4;
    }
</style>