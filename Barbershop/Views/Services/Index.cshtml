@model IEnumerable<Barbershop.Models.Service>

@{
    ViewData["Title"] = "Index";
}

<h1>Service Management</h1>

<p>
    <a asp-action="Create" class="bi bi-plus-square-fill fs-2"></a>
</p>
<table class="table table-striped">
    <thead class="bg-dark text-white">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ServiceName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ServiceName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ServiceId" class="bi bi-pencil-square btn-primary"></a> |
                <a asp-action="Details" asp-route-id="@item.ServiceId" class="bi bi-file-earmark-text btn-success"></a> |
                    <a asp-action="Delete" asp-route-id="@item.ServiceId" class="bi bi-trash btn-danger"></a>
            </td>
        </tr>
}
    </tbody>
</table>
