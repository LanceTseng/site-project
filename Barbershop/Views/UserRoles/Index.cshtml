@model IEnumerable<Barbershop.Models.UserRole>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th>User Name</th>
            <th>
                @Html.DisplayNameFor(model => model.Role)
            </th>
            <th>Role Name</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.User.UserId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.User.Username)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Role.RoleId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Role.RoleName)
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { uid = @item.UserId , rid = @item.RoleId}) |
                    @Html.ActionLink("Details", "Details", new { uid = @item.UserId }) |
                    @Html.ActionLink("Delete", "Delete", new { uid = @item.UserId})
                </td>
            </tr>
        }
    </tbody>
</table>
