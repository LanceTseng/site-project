@model IEnumerable<UserRole>
@{
    ViewData["Title"] = "AssignRole";
}

<h1>AssignRole</h1>

<form asp-action="AssignRole" method="post">
    <input type="number" name="userId" placeholder="User ID" />
    <input type="number" name="roleId" placeholder="Role ID" />
    <button type="submit" class="btn btn-primary">Assign Role</button>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>User ID</th>
            <th>User Name</th>
            <th>Role ID</th>
            <th>Role Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var userRole in Model)
        {
            <tr>
                <td>@userRole.UserId</td>
                <td>@userRole.User.Username</td>
                <td>@userRole.RoleId</td>
                <td>@userRole.Role.RoleName</td>
            </tr>
        }
    </tbody>
</table>