@{
    ViewData["Title"] = "Index";
}

<h1>Admin Dashboard</h1>

<div class="container mt-4">
    <div class="row">
        <!-- User Management Section -->
        <div class="col-md-6">
            <div class="card text-center">
                <div class="card-header bg-primary text-white">
                    User Management
                </div>
                <div class="card-body">
                    <p>Manage user accounts, roles, and permissions.</p>
                    <a href="@Url.Action("Index", "Users")" class="btn btn-primary">Manage Users</a>
                    <a href="@Url.Action("Index", "Roles")" class="btn btn-primary">Manage Roles</a>
                    <a href="@Url.Action("Index", "UserRoles")" class="btn btn-primary">Assign Roles</a>
                </div>
            </div>
        </div>


        <!-- Reports Section -->
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-header bg-success text-white">
                    Reports
                </div>
                <div class="card-body">
                    <p>Access business reports and analytics.</p>
                    <a href="@Url.Action("Index", "Schedules")" class="btn btn-success">Schedules</a>
                    <a href="@Url.Action("Index", "Orders")" class="btn btn-success">Orders</a>
                </div>
            </div>
        </div>
        
        <!-- Setting Section -->
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-header bg-info text-dark">
                    Setting
                </div>
                <div class="card-body">
                    <p>Service setting.</p>
                    <a href="@Url.Action("Index", "Services")" class="btn btn-info text-dark">Services</a>
                </div>
            </div>
        </div>
    </div>


</div>
<style>
    body {
        background-color: #bbdaf4;
        font-family: Arial, sans-serif;
    }
</style>