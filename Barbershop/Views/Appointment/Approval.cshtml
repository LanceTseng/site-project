@model ApprovalViewModel
@{
    ViewData["Title"] = "Approval";
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
    var userId = ViewBag.UserId as string;
}
 
<div class="container mt-5">
    <div class="row">
        <!-- Left Panel: Filter Form -->
        <div class="col-md-4 bg-light p-4 rounded shadow-sm">
            <h4 class="fw-bold mb-4">Approval Filters</h4>
            <form id="filterForm" method="post">
                <div class="mb-3">
                    <label for="barberSelect" class="form-label">Select Barber</label>
                    @if (isAdmin)
                    {
                        <select id="barberSelect" class="form-select" asp-for="Filter.BarberId">
                            <option value="">-- Select Barber --</option>
                            @foreach (var barber in Model.Barbers)
                            {
                                <option value="@barber.Value">@barber.Text</option>
                            }
                        </select>
                    }
                    else
                    {
                        <select id="barberSelect" class="form-select" asp-for="Filter.BarberId">
                            @foreach (var barber in Model.Barbers.Where(x => x.Value == userId))
                            {
                                <option value="@barber.Value">@barber.Text</option>
                            }
                        </select>
                    }

                </div>
                <div class="mb-3">
                    <label for="dateSelect" class="form-label">Select Date</label>
                    <input type="date" id="dateSelect" class="form-control" asp-for="Filter.Date" />
                </div>
                <div class="mb-3">
                    <label for="statusSelect" class="form-label">Select Status</label>
                    <select id="statusSelect" class="form-select" asp-for="Filter.Status">
                        <option value="">-- Select Status --</option>
                        <option value="New">New</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="Cancel">Cancel</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary w-100">Search</button>
            </form>
        </div>

        <!-- Right Panel: Schedule Table -->
        <div class="col-md-8">
            <h4 class="fw-bold mb-4">Appointments</h4>
            <div id="scheduleTableContainer">
                @await Html.PartialAsync("_ScheduleTable", Model.Schedules)
            </div>
        </div>
    </div>
</div>

<script>

       const querySchedule = async (scheduleDate, barber, status) => {
           const scheduleTableContainer = document.getElementById('scheduleTableContainer');

           const loadingIndicator = document.createElement('div');
    loadingIndicator.innerText = 'Loading...';
    scheduleTableContainer.appendChild(loadingIndicator);

    const filterData = {
        barberId: barber || null,  // If barber is empty, send null
        date: scheduleDate ? new Date(scheduleDate) : null,  // If date is empty, send null
        status: status || null     // If status is empty, send null
    };

    try {
        const response = await fetch('/Appointment/GetFilteredSchedules', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(filterData),
        });

        if (!response.ok) {
            throw new Error('Failed to fetch filtered schedules.');
        }

        const result = await response.text();
        console.log(result);
        // If no schedules found, show a message
        if (response.error) {
            // Show a Bootstrap alert for no data found
            scheduleTableContainer.innerHTML = `
                <div class="alert alert-warning" role="alert">
                    ${result.error}
                </div>
            `;
        } else {
            // Update the schedule table container with new data
              scheduleTableContainer.innerHTML = result;
        }

    } catch (error) {
        console.error(error);
        alert('Error refreshing schedule table. Please try again.');
    } finally {
        // Remove the loading indicator once the data is fetched or failed
        loadingIndicator.remove();
    }
    };

    const initializeEventListeners = () => {
    // Attach event listener to the form
       document.getElementById('filterForm').addEventListener('submit', function (e) {
            event.preventDefault(); // Prevent form submission

            // Get filter values
            const scheduleDate = document.getElementById('dateSelect').value;
            const barber = document.getElementById('barberSelect').value;
            const status = document.getElementById('statusSelect').value;

            // Call the query function
            querySchedule(scheduleDate, barber, status);
        });
    }

    // Run initialization on page load
    document.addEventListener('DOMContentLoaded', initializeEventListeners);
</script>