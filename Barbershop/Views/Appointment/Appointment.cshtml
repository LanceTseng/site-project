@model SchedulingViewModel
@{
    ViewData["Title"] = "Schedule";
    var role = ViewBag.UserRole;
    var userName = ViewBag.UserName;
}

<div class="container mt-4">
    <h2>Schedule Appointment</h2>
    <div class="row">
        <!-- Left Side: Form for scheduling -->
        <div class="col-md-6">
            <h4>Appointment Details</h4>
            <form asp-action="ScheduleAppointment" method="post">
                @Html.AntiForgeryToken()
                <!-- Customer Name (Read-Only) -->
                <div class="mb-3">
                    <label>Customer Name</label>
                    <input type="text" class="form-control" value="@User.Identity.Name" readonly />
                </div>

                <!-- Barber Selection -->
                <div class="mb-3">
                    <label for="barberId">Select Barber</label>
                    <select asp-for="BarberId" class="form-control" asp-items="Model.BarberList">
                        <option value="">Select Barber</option>
                    </select>
                    @Html.ValidationMessageFor(model => model.BarberId)
                </div>

                <!-- Service Selection -->
                <div class="mb-3">
                    <label for="serviceId">Select Service</label>
                    <select asp-for="ServiceId" class="form-control" asp-items="Model.ServiceList" id="serviceId">
                        <option value="">Select Service</option>
                    </select>
                    <!-- Display Price next to the dropdown -->
                </div>


                <!-- Date Selection -->
                <div class="mb-3">
                    <label for="appointmentDate">Select Date</label>
                    <input asp-for="AppointmentDate" type="date" class="form-control" id="appointmentDate" />
                </div>

                <!-- Time Selection -->
                <div class="row mb-3">
                    <div class="col">
                        <label for="startTime">Start Time</label>
                        <select asp-for="StartTime" class="form-control">
                            <option value="">Select Start Time</option>
                            @foreach (var time in Model.AvailableTimes)
                            {
                                <option value="@time">@time</option>
                            }
                        </select>
                    </div>
                    <div class="col">
                        <label for="endTime">End Time</label>
                        <select asp-for="EndTime" class="form-control">
                            <option value="">Select End Time</option>
                            @foreach (var time in Model.AvailableTimes)
                            {
                                <option value="@time">@time</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-primary">Submit</button>
            </form>
        </div>

        <!-- Right Side: Confirmation Information -->
        <div class="col-md-6">
            <h4>Confirmation</h4>
            <div id="confirmationDetails">
                @await Html.PartialAsync("_ConfirmationDetails", @Model.ConfirmationDetails)
            </div>
        </div>
    </div>
</div>
<script>
    // Set the default date to today and lock previous dates
    window.onload = function () {
        var today = new Date().toISOString().split('T')[0]; // Get today's date in YYYY-MM-DD format
        var appointmentDateInput = document.getElementById("appointmentDate");

        // Set the min attribute to today to lock previous dates
        appointmentDateInput.setAttribute('min', today);

        // Set the default value to today's date
        appointmentDateInput.value = today;
    };
</script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $("form").on("submit", function (e) {
            e.preventDefault(); // Prevent default form submission

            $.ajax({
                url: '@Url.Action("ScheduleAppointment", "Appointment")',
                type: 'POST',
                data: $(this).serialize(),
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    // Update the confirmation details section with the partial view response
                    $("#confirmationDetails").html(response);
                },
                error: function (xhr) {
                    alert("An error occurred while scheduling the appointment.");
                }
            });
        });
    });
</script>

@* CSS *@
<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #bbdaf4;
        color: #333;
        margin: 0;
        padding: 0;
    }

    h2 {
        text-align: center;
        margin-bottom: 80px;
        color: #0056b3; /* Dark blue color */
        font-family: Futura, sans-serif;
        font-weight: bold;
    }

    /* Styling for the appointment form */
    form#appointmentForm {
        border: 2px solid #0c77e9; /* Blue border */
        border-radius: 20px; /* Rounded corners */
        background-color: #e7eff6; /* Light gray background */
        padding: 30px; /* Space inside the form */
        box-shadow: 5px 4px 8px rgba(0, 0, 0, 0.1);
    }


    h4 {
        color: #0056b3;
        font-family: Futura;
        font-weight: bold;
        margin-bottom: 20px;
    }


    form#appointmentForm button {
        background-color: #007bff;
        color: #f8f9fa border-radius: 10px;
        padding: 10px 10px;
        font-size: 20px;
        cursor: pointer;
        transition: background-color 0.1s ease;
    }

        form#appointmentForm button:hover {
            background-color: #163352;
        }

</style>