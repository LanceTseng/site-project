    For more information on enabling MVC for empty projects, visit http://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<Schedule>

<table class="table table-bordered table-hover shadow-sm">
    <thead class="table-light">
    <tr>
        <th>Schedule ID</th>
        <th>Date</th>
        <th>Start Time</th>
        <th>End Time</th>
        <th>Barber</th>
        <th>Customer</th>
        <th>Service</th>
        <th>Status</th>
        <th>Action</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var schedule in Model)
    {
        <tr>
            <td>@schedule.ScheduleId</td>
            <td>@schedule.StartTime.ToShortDateString()</td>
            <td>@schedule.StartTime.ToShortTimeString()</td>
            <td>@schedule.EndTime.ToShortTimeString()</td>
            <td>@schedule.Barber.Username</td>
            <td>@schedule.Customer.Username</td>
            <td>@schedule.Service.ServiceName</td>
            <td>
                <select class="form-select form-select-sm" asp-for="@schedule.Status" disabled="">
                    <option value="New">New</option>
                    <option value="Confirmed">Confirmed</option>
                    <option value="Cancel">Cancel</option>
                </select>
            </td>
            <td>
                <button id="approval" type="button" class="btn btn-outline-success" data-id="@schedule.ScheduleId">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check2-square" viewBox="0 0 16 16">
                        <path d="M3 14.5A1.5 1.5 0 0 1 1.5 13V3A1.5 1.5 0 0 1 3 1.5h8a.5.5 0 0 1 0 1H3a.5.5 0 0 0-.5.5v10a.5.5 0 0 0 .5.5h10a.5.5 0 0 0 .5-.5V8a.5.5 0 0 1 1 0v5a1.5 1.5 0 0 1-1.5 1.5z"></path>
                        <path d="m8.354 10.354 7-7a.5.5 0 0 0-.708-.708L8 9.293 5.354 6.646a.5.5 0 1 0-.708.708l3 3a.5.5 0 0 0 .708 0"></path>
                    </svg>
                </button>
                <button id="cancel" type="button" class="btn btn-outline-danger" data-id="@schedule.ScheduleId">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"></path>
                        <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"></path>
                    </svg>
                </button>
            </td>
        </tr>
    }
    </tbody>
</table>

<script>
      const reloadForm = () => {
        fetch('/Appointment/GetSchedules') // Update with your actual controller and action
            .then(response => {
                if (!response.ok) throw new Error('Failed to load schedule data.');
                return response.text();
            })
            .then(html => {
                document.querySelector('#scheduleContainer').innerHTML = html;
                initialActionListeners(); // Reattach event listeners
            })
            .catch(error => console.error(error));
    };

    const actionAppointment = (scheduleId, status) => {
        fetch('/Appointment/UpdateAppointmentStatus', { // Replace with your actual update endpoint
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ scheduleId, status })
        })
            .then(response => {
                if (response.ok) {
                    console.log(`Schedule ${scheduleId} updated to ${status}`);
                    reloadForm(); // Refresh the partial view
                } else {
                    throw new Error('Failed to update schedule.');
                }
            })
            .catch(error => console.error(error));
    };

    const initialActionListeners = () => {
               document.querySelector('#scheduleTableContainer').addEventListener('click', function (e) {
            if (e.target.closest('.approval')) {
                const scheduleId = e.target.closest('.approval').getAttribute('data-id');
                actionAppointment(scheduleId, "Confirmed");
            } else if (e.target.closest('.cancel')) {
                const scheduleId = e.target.closest('.cancel').getAttribute('data-id');
                actionAppointment(scheduleId, "Cancel");
            }
        });
    };

    // Initialize all event listeners
    initialActionListeners();
</script>
