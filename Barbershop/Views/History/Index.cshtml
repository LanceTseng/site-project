@model AppointmentFilterViewModel
@{
    ViewData["Title"] = "Index";
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
    var userId = ViewBag.UserId as string;
    var isEmployee = ViewBag.UserRole == "EMPLOYEE";
    var isCustomer = ViewBag.UserRole == "CUSTOMER";
}

<h1>History</h1>
<div class="container-fluid">
    <div class="row">
        <!-- Left Side: Query Conditions -->
        <div class="col-md-3 border-end">
            <h5>Query Conditions</h5>
            <form id="queryForm" method="post">
                <div class="mb-3">
                    <label for="startDate" class="form-label">Appointment Date</label>
                    <input type="date" class="form-control" id="startDate" name="startDate">
                </div>
                <div class="mb-3">
                    <label for="customer" class="form-label">Customer</label>
                    @if (isEmployee || isAdmin) 
                    {
                        <select id="customerSelect" class="form-select" name="customer">
                            <option value="">All Customers</option>
                            @foreach (var customer in Model.Customers)
                            {
                                <option value="@customer.Value">@customer.Text</option>
                            }
                        </select>
                    }
                    else
                    {
                        <select id="customerSelect" class="form-select" name="customer">
                            @foreach (var customer in Model.Customers.Where(x=>x.Value == userId))
                            {
                                <option value="@customer.Value">@customer.Text</option>
                            }
                        </select>
                    }
                  
                </div>
                <div class="mb-3">
                    <label for="barber" class="form-label">Barber</label>
                    @if (isCustomer || isAdmin)
                    {
                        <select id="barberSelect" class="form-select" name="barber">
                            <option value="">All Barbers</option>
                            @foreach (var barber in Model.Barbers)
                            {
                                <option value="@barber.Value">@barber.Text</option>
                            }
                        </select>
                    }
                    else
                    {
                        <select id="barberSelect" class="form-select" name="barber">
                            @foreach (var barber in Model.Barbers.Where(x=>x.Value == userId))
                            {
                                <option value="@barber.Value">@barber.Text</option>
                            }
                        </select>
                    }
                   
                </div>
                <div class="mb-3">
                    <label for="status" class="form-label">Status</label>
                    <select id="statusSelect" class="form-select" name="status">
                        <option value="">All Statuses</option>
                        <option value="New">New</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="Closed">Closed</option>
                        <option value="Cancel">Cancel</option>
                    </select>
                </div>
                <div class="d-grid">
                    <button type="button" class="btn btn-primary" id="queryButton">Query</button>
                </div>
            </form>
        </div>

        <!-- Right Side: Partial View for Table -->
        <div class="col-md-9">
            <div id="historyTableContainer">
                @await Html.PartialAsync("_HistoryTable", Model.HistoryList)
            </div>
        </div>
    </div>
</div>
<script>
    const queryHistory = async (barber, customer, scheduleDate, status) => {
        const historyTableContainer = document.getElementById('historyTableContainer');

        // Remove any existing loading indicator
        const existingIndicator = document.querySelector('.loading-indicator');
        if (existingIndicator) existingIndicator.remove();

        // Add a new loading indicator
        const loadingIndicator = document.createElement('div');
        loadingIndicator.innerText = 'Loading...';
        loadingIndicator.classList.add('loading-indicator');
        historyTableContainer.appendChild(loadingIndicator);

        const filterData = {
            scheduleDate: scheduleDate || null,
            barberId: barber || null,
            customerId: customer || null,
            status: status || null,
        };

        console.log(filterData);

        try {
            const response = await fetch('/history/GetFilteredHistory', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(filterData),
            });

            if (!response.ok) {
                throw new Error('Failed to fetch filtered history.');
            }

            const result = await response.text();

            if (!result.trim()) {
                historyTableContainer.innerHTML = `
                    <div class="alert alert-warning" role="alert">
                        No records found for the selected filters.
                    </div>
                `;
            } else {
                historyTableContainer.innerHTML = result;
            }
        } catch (error) {
            console.error(error);
            alert('Error refreshing the history table. Please try again.');
        } finally {
            loadingIndicator.remove();
        }
    };

    document.getElementById('queryButton').addEventListener('click', function () {
        // Get filter values
        const scheduleDate = document.getElementById('startDate').value;
        const barber = document.getElementById('barberSelect').value;
        const customer = document.getElementById('customerSelect').value;
        const status = document.getElementById('statusSelect').value;

        // Call the query function
        queryHistory(barber, customer, scheduleDate, status);
    });
</script>
<style>
    .loading-indicator {
        font-size: 18px;
        color: #007bff;
        font-weight: bold;
        text-align: center;
        margin-top: 20px;
    }
</style>