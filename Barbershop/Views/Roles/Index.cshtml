@model IEnumerable<Barbershop.Models.Role>

@{
    ViewData["Title"] = "Index";
}

<h1>Role Management</h1>

<p>
    <a asp-action="Create" class="bi bi-plus-square-fill fs-2"></a>
</p>
<table class="table table-striped">
    <thead class="bg-dark text-white">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.RoleName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.RoleName)
            </td>
            <td>
                    <a asp-action="Edit" asp-route-id="@item.RoleId" class="bi bi-pencil-square btn-primary"></a> |
                    <a asp-action="Delete" asp-route-id="@item.RoleId" class="bi bi-trash btn-danger"></a>
            </td>
        </tr>
}
    </tbody>
</table>
